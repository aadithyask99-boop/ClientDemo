{
  "name": "inbound-voice spikes",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "hostRequirements": { "cpus": 4, "memory": "16gb", "storage": "32gb" },
  "forwardPorts": [3000, 3100, 5555],
  "portsAttributes": {
    "3000": { "label": "Twenty or Cal.diy web (one at a time)" },
    "3100": { "label": "call-service" },
    "5555": { "label": "Cal.diy API v2" }
  },
  "postCreateCommand": "cd inbound-voice/call-service && npm install --no-audit --no-fund"
}
