{
  "name": "clientdemo",
  "compatibility_date": "2026-10-01",
  "main": "flow-mcp/src/index.js",
  "compatibility_flags": ["nodejs_compat"],
  "browser": { "binding": "BROWSER" },
  "kv_namespaces": [{ "binding": "FLOW_STATE" }],
  "build": {
    "command": "(cd flow-mcp && npm ci --omit=dev) && cd doves-uk && npm ci && node scripts/stage.mjs && cd ../ileife && npm ci && node scripts/stage.mjs && cd ../djeska && npm ci && node scripts/stage.mjs && cd ../halcyon && npm ci && node scripts/stage.mjs && cd ../orra && npm ci && node scripts/stage.mjs && cd ../more-coffee && npm ci && node scripts/stage.mjs && cd ../garden && npm ci && node scripts/stage.mjs && cd ../portfolio && npm ci && node scripts/stage.mjs && cd ../evm2 && npm ci && node scripts/stage.mjs && cd ../kerala && npm ci && node scripts/stage.mjs && cd ../kerala2 && npm ci && node scripts/stage.mjs && cd ../kerala3 && npm ci && node scripts/stage.mjs && cd .. && cp demo-index/index.html site/index.html"
  },
  "assets": {
    "directory": "./site",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": ["/signin/*", "/mcp/*", "/mcp", "/health"]
  }
}
