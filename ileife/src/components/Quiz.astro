---
import { brand, quiz as c, treatments } from '../data/site';

// The script reads this once: questions, answer weights, personas and the matching facial
const data = {
  questions: c.questions,
  personas: c.personas,
  treatments: treatments.list.map((t) => ({ id: t.id, name: t.name, price: t.price, for: t.for })),
  book: brand.book,
};
---

<section class="sec quiz" id="persona" data-tone-section="plum">
  <div class="wrap">
    <div class="quiz__in" data-quiz data-quiz-data={JSON.stringify(data)}>
      <h2 class="h2" data-split>{c.title[0]} <span class="ac">{c.title[1]}</span></h2>
      <div class="quiz__stage" data-stage aria-live="polite">
        <p class="lede muted" data-intro style="max-width:36rem">{c.lede}</p>
        <button class="btn btn--lg" type="button" data-start data-magnet><span class="lbl">Begin</span><span class="arr" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M5 13 13 5M6 5h7v7" /></svg></span></button>
      </div>
      <div class="quiz__dots" data-dots aria-hidden="true">
        {c.questions.map(() => <i />)}
      </div>
    </div>
  </div>
</section>
