---
// Back to top: appears once the page has moved, the ring fills as you read down the page.
---

<button class="totop" type="button" data-totop aria-label="Back to top">
  <svg class="totop__ring" viewBox="0 0 48 48" aria-hidden="true">
    <circle class="totop__track" cx="24" cy="24" r="22" />
    <circle class="totop__bar" cx="24" cy="24" r="22" data-bar />
  </svg>
  <svg class="totop__arrow" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
    <path d="M9 15V3M4 8l5-5 5 5" />
  </svg>
</button>

<style is:global>
  .totop {
    position: fixed;
    right: var(--gutter);
    bottom: 1.4rem;
    z-index: 45;
    width: 3.4rem;
    height: 3.4rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: var(--pill-fg);
    background: var(--pill-bg);
    box-shadow: 0 14px 34px -14px rgba(27, 20, 28, 0.6);
    opacity: 0;
    transform: translateY(14px) scale(0.92);
    pointer-events: none;
    transition:
      opacity 0.5s var(--ease),
      transform 0.6s var(--ease),
      background-color var(--tone-ms) var(--ease),
      color var(--tone-ms) var(--ease);
  }

  .totop.show {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .totop__ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }

  .totop__track,
  .totop__bar {
    fill: none;
    stroke-width: 1.5;
  }

  .totop__track {
    stroke: color-mix(in srgb, var(--pill-fg) 22%, transparent);
  }

  .totop__bar {
    stroke: var(--pill-fg);
    stroke-linecap: round;
    stroke-dasharray: 138.2;
    stroke-dashoffset: 138.2;
  }

  .totop__arrow {
    position: relative;
    transition: transform 0.5s var(--ease);
  }

  .totop:hover .totop__arrow {
    transform: translateY(-3px);
  }

  @media (max-width: 880px) {
    .totop {
      width: 3rem;
      height: 3rem;
      bottom: 1rem;
    }
  }
</style>
