---
import Photo from './Photo.astro';
import hero from '../assets/photos/p25293894.jpg';
import { hero as c } from '../data/site';

const arrow = 'M5 13 13 5M6 5h7v7';
---

<section class="hero" id="top" data-tone-section="plum">
  <div class="hero__img">
    <Photo src={hero} alt="A woman looking over her shoulder, her skin glowing against a warm brown backdrop" sizes="(max-width: 880px) 100vw, 58vw" widths={[800, 1200, 1700, 2400]} position="50% 16%" eager />
  </div>
  <div class="hero__in">
    <div class="hero__main">
      <h1 class="display" data-split>{c.title[0]}<br /><span class="ac">{c.title[1]}</span> {c.title[2]}</h1>
      <div class="hero__sub clr" style="--d:0.1s">
        <p>{c.lede}</p>
        <div class="hero__act">
          <a class="btn btn--lg" href="#book" data-magnet>
            <span class="lbl">Book a facial</span>
            <span class="arr" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.2"><path d={arrow} /></svg></span>
          </a>
          <a class="link" href="#persona">Find your skin persona</a>
        </div>
      </div>
    </div>
    <div class="hero__bar clr" style="--d:0.25s">
      <span>Facials from £90 · South London</span>
      <a class="scroll" href="#intro">
        <span>Scroll down to continue</span>
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M9 3v12M4 10l5 5 5-5" /></svg>
      </a>
    </div>
  </div>
</section>
