---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Intro from '../components/Intro.astro';
import Rules from '../components/Rules.astro';
import Treatments from '../components/Treatments.astro';
import Quiz from '../components/Quiz.astro';
import Princess from '../components/Princess.astro';
import Notes from '../components/Notes.astro';
import Reviews from '../components/Reviews.astro';
import Request from '../components/Request.astro';
import Visit from '../components/Visit.astro';
import Results from '../components/Results.astro';
import Footer from '../components/Footer.astro';
import ToTop from '../components/ToTop.astro';
---

<Base
  title="ILÉ IFÉ | Restorative facials in South London"
  description="A calm, intimate space for restorative skin care in South London. Glow, Clarity, Balance and Collagen facials with Princess Adeyemi."
>
  <Header />
  <main>
    <Hero />
    <Intro />
    <Rules />
    <Treatments />
    <Results />
    <Quiz />
    <Princess />
    <Visit />
    <Notes />
    <Reviews />
    <Request />
  </main>
  <Footer />
  <ToTop />
  <div class="glow" data-glow aria-hidden="true"></div>
</Base>
