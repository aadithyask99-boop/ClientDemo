---
import '@fontsource-variable/unbounded';
import '@fontsource-variable/hanken-grotesk';
import '@fontsource/jetbrains-mono/400.css';
import '../styles/global.css';
import { brand, nav, services, kids, shops, barbers, cuts, props, plans, shelf, giftAmounts, reviews, faq, statement, contact } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const art = base + 'art/';
const data = { services, shops, barbers, cuts, props, plans, giftAmounts, reviews };
const mark = 'M3 17 C9 5 17 4 25 7';
const byId = (id: string) => barbers.find((b) => b.id === id)!;
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{brand.title}</title>
  <meta name="description" content={brand.description} />
  <meta name="theme-color" content="#0a0a0a" />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%230a0a0a'/%3E%3Cpath d='M7 22 C13 8 19 8 25 10' stroke='%23efeeea' stroke-width='3' fill='none' stroke-linecap='round'/%3E%3C/svg%3E" />
  <script is:inline>document.documentElement.classList.add('js');</script>
</head>
<body data-art={art}>
  <!-- Intro: fur and a curved line, then the two words that become the hero -->
  <div class="intro" data-intro aria-hidden="true">
    <img class="intro__fur" src={art + 'hair.webp'} alt="" />
    <p class="intro__tag">Sidecut &middot; Soho, Shoreditch, King's Cross</p>
    <p class="intro__w1" data-iw1>side</p>
    <p class="intro__w2" data-iw2>cut</p>
    <svg class="intro__line" viewBox="0 0 1000 1000" preserveAspectRatio="none" aria-hidden="true">
      <path d="M1040 1040 C 930 880 940 520 1010 -40" fill="none" stroke="#efeeea" stroke-width="5" stroke-linecap="round" vector-effect="non-scaling-stroke" />
    </svg>
    <button class="intro__skip" data-skip type="button">Skip <span aria-hidden="true">+</span></button>
  </div>

  <header class="nav" data-nav>
    <a class="nav__logo" href="#top" aria-label="Sidecut, back to the top">
      <svg width="28" height="22" viewBox="0 0 28 22" fill="none" aria-hidden="true"><path d={mark} stroke="currentColor" stroke-width="2.4" stroke-linecap="round" /></svg>
      <span>SIDECUT</span>
    </a>
    <nav class="nav__links" aria-label="Main">
      {nav.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <button class="book-pill" type="button" data-book>Book <i aria-hidden="true">↗</i></button>
  </header>

  <main id="top">
    <!-- 1. Hero: a thin word top-left, a heavy word bottom-right, the chair between them -->
    <section class="hero" data-hero>
      <div class="hero__scene">
        <p class="hero__w1" data-w1 aria-hidden="true">side</p>
        <p class="hero__w2" data-w2 aria-hidden="true">cut</p>
        <div class="hero__cone" aria-hidden="true"></div>
        <div class="hero__pool" aria-hidden="true"></div>
        <div class="hero__stage" data-stage>
          <canvas class="hero__chair" data-chair role="img" aria-label="A leather barber chair that turns as you drag or scroll"></canvas>
        </div>
      </div>
      <h1 class="hero__title" aria-label="You pick the cut. We do the rest."><span class="hero__t1" aria-hidden="true">You pick the cut.</span><span class="hero__t2" aria-hidden="true">We do the <span data-type>rest.</span></span></h1>
      <p class="hero__status" data-status><span class="dot" aria-hidden="true"></span> Open now &middot; next chair <b data-next>2:40 PM</b></p>
      <div class="hero__copy" data-herocopy>
        <p>Fades, tapers and hot-towel shaves in three shops across central London. <strong>Book your barber in under a minute.</strong></p>
        <div class="hero__btns">
          <button class="book-pill book-pill--lg" type="button" data-book>Book a chair <i aria-hidden="true">↗</i></button>
          <a class="pill pill--out" href="#cuts">See prices</a>
        </div>
        <p class="hero__stars">&#9733;&#9733;&#9733;&#9733;&#9733; 4.9 &middot; 612 Google reviews</p>
      </div>
    </section>

    <!-- 2. The guard menu: hover a cut and its tool comes to the cursor -->
    <section class="sec sec--light cuts" id="cuts">
      <h2 class="h2" data-reveal><span class="ln"><span><span class="l">Every cut </span><span class="b">has a number.</span></span></span></h2>
      <p class="lead">Prices include the wash, the hot towel on the neck and a line-up on the way out. No surprises at the chair.</p>
      <ol class="cuts__list" data-cuts>
        {services.map((s) => (
          <li>
            <button type="button" class="cut" data-book={`service:${s.n}`} data-tool={s.tool} aria-label={`Book ${s.name}, ${s.min} minutes, £${s.price}`}>
              <span class="cut__n">#{s.n}</span>
              <span class="cut__main"><strong>{s.name}</strong><small>{s.text}</small></span>
              <span class="cut__min">{s.min} min</span>
              <span class="cut__price">£{s.price}</span>
              <span class="cut__go">Book <i aria-hidden="true">↗</i></span>
            </button>
          </li>
        ))}
        <img class="cuts__tool" data-toolpop alt="" aria-hidden="true" draggable="false" />
      </ol>
      <p class="cuts__note"><span class="dot dot--dark" aria-hidden="true"></span> {kids}</p>
    </section>

    <!-- 3. Why book here: tools to drag and click -->
    <section class="sec sec--light why" data-why>
      <p class="why__text" data-reveal-words>{statement[0]}<strong>{statement[1]}</strong></p>
      {props.map((p, i) => (
        <img class={`prop prop--${p.id}`} data-prop={i} style={`--w:${p.w}vw`} src={art + `prop-${p.id}.webp`} alt="" draggable="false" />
      ))}
      <p class="why__pill" data-pill role="status" aria-live="polite"><b data-pill-big>-1 day</b><span data-pill-small>A reminder text the day before.</span></p>
    </section>

    <!-- 4. Four mirrors: an expanding gallery, one lamp per mirror -->
    <section class="sec sec--dark mirrors" id="barbers">
      <h2 class="h2" data-reveal><span class="ln"><span><span class="l">Four mirrors. </span><span class="b">Pick yours.</span></span></span></h2>
      <p class="lead">Each barber has their own station and their own diary. Pick a mirror to switch its lamp on.</p>
      <div class="mirrors__row" data-mirrors>
        {barbers.map((b, i) => (
          <div class={`mirror${i === 1 ? ' is-on' : ''}`} data-mirror={i} tabindex="0" role="button" aria-label={`${b.name}, ${b.does}, ${b.shopName}`}>
            <span class="mirror__lamp" aria-hidden="true"><i></i></span>
            <span class="mirror__glass">
              <img src={art + `mirror-${b.id}.webp`} alt={`${b.name} cutting hair, seen in the mirror`} width="1200" height="800" decoding="async" />
              <span class="mirror__light" aria-hidden="true"></span>
              <span class="mirror__name">
                <strong>{b.name}</strong>
                <em>{b.does} · {b.years} yrs · {b.langs}</em>
                <button type="button" class="link" data-book={`barber:${b.id}`}>Book {b.name} <span aria-hidden="true">↗</span></button>
              </span>
            </span>
          </div>
        ))}
      </div>
    </section>

    <!-- 5. The book: nine cuts, the back of the head on hover -->
    <section class="sec sec--dark book">
      <h2 class="h2 book__title" data-reveal><span class="ln"><span><span class="l">See the back </span><span class="b">before you sit.</span></span></span></h2>
      <div class="book__filters" role="group" aria-label="Filter by barber">
        <button type="button" class="chip is-on" data-filter="all" aria-pressed="true">All</button>
        {barbers.map((b) => <button type="button" class="chip" data-filter={b.id} aria-pressed="false">{b.name}</button>)}
      </div>
      <div class="book__grid" data-bookgrid>
        {cuts.map((c) => (
          <figure class="cutcard" data-who={c.by} tabindex="0">
            <div class="cutcard__ph">
              <img class="cutcard__f" src={art + `barber-${c.id}-f.webp`} alt={`${c.name}, cut by ${byId(c.by).name}`} width="720" height="960" decoding="async" />
              <img class="cutcard__b" src={art + `barber-${c.id}-b.webp`} alt={`${c.name} from behind`} width="720" height="960" decoding="async" />
              <span class="cutcard__tag">Hover · back</span>
            </div>
            <figcaption>
              <span class="cutcard__row"><strong>{c.name}</strong><b>£{c.price}</b></span>
              <button type="button" class="cutcard__book" data-book={`service:${c.service}`}>Book this cut</button>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <!-- 6. The club: a hand of three cards -->
    <section class="sec sec--light club" id="club">
      <h2 class="h2" data-reveal><span class="ln"><span><span class="l">Your cut, </span><span class="b b--grey">on a schedule.</span></span></span></h2>
      <p class="lead">A fade holds about three weeks. Members keep a standing chair and pay less than walking in.</p>
      <div class="club__fan" data-fan>
        {plans.map((p, i) => (
          <article class={`plan plan--${i}${p.hot ? ' plan--hot' : ''}`} data-plan>
            {p.hot && <span class="plan__flag">Most booked</span>}
            <h3>{p.name}</h3>
            <p class="plan__price"><b>£{p.price}</b><small>/month</small></p>
            <ul>{p.items.map((it) => <li>{it}</li>)}</ul>
            <p class="plan__save">You save<br /><b data-save={p.save}>£{p.save}</b> a month</p>
            <button type="button" class={`pill ${p.hot ? 'pill--light' : 'pill--ghost'}`} data-book>{p.cta} <span aria-hidden="true">↗</span></button>
          </article>
        ))}
      </div>
    </section>

    <!-- 7. The shelf -->
    <section class="sec sec--dark shelf" id="shelf">
      <h2 class="h2" data-reveal><span class="ln"><span><span class="l">What your barber </span><span class="b">used on you.</span></span></span></h2>
      <p class="lead">Pick it up at the chair or have it delivered across London the next day.</p>
      <ul class="shelf__row">
        {shelf.map((g) => (
          <li>
            <div class="shelf__card">
              <span class="shelf__beam" aria-hidden="true"></span>
              <img src={art + `shelf-${g.id}.webp`} alt={g.name} loading="lazy" width="700" height="700" />
              <span class="shelf__plinth" aria-hidden="true"></span>
            </div>
            <div class="shelf__meta"><strong>{g.name}</strong><span>£{g.price}</span><button type="button" class="pill pill--light" data-add={g.name}>Add</button></div>
          </li>
        ))}
      </ul>
    </section>

    <!-- 8. Gift cards -->
    <section class="sec sec--dark gift" data-gift>
      <div class="gift__stage">
        <div class="gift__card" data-card>
          <span class="gift__metal" role="img" aria-label="A brushed silver Sidecut gift card"></span>
          <svg class="gift__mark" width="34" height="26" viewBox="0 0 28 22" fill="none" aria-hidden="true"><path d={mark} stroke="#1b1b1d" stroke-width="2.2" stroke-linecap="round" /></svg>
          <span class="gift__brand">SIDECUT</span>
          <span class="gift__amt" data-amt>£100</span>
          <span class="gift__fine">Gift card &middot; Soho, Shoreditch, King's Cross</span>
          <span class="gift__shine" aria-hidden="true"></span>
        </div>
      </div>
      <div class="gift__copy">
        <h2 class="gift__title" data-reveal><span class="ln"><span><span class="l">A chair, </span><span class="b">gift-wrapped.</span></span></span></h2>
        <p>Sent by email in a minute, good for any service or product, never expires.</p>
        <div class="gift__amounts" role="group" aria-label="Amount">
          {giftAmounts.map((a, i) => <button type="button" class={`chip${i === 1 ? ' is-on' : ''}`} data-amount={a} aria-pressed={i === 1 ? 'true' : 'false'}>£{a}</button>)}
        </div>
        <button type="button" class="book-pill" data-gift-send>Send a gift card <i aria-hidden="true">↗</i></button>
      </div>
    </section>

    <!-- 9. Reviews -->
    <section class="sec sec--light reviews" data-reviews>
      <div class="reviews__body">
        <p class="reviews__score" aria-label="4.9 out of 5"><span data-score>4.9</span></p>
        <figure class="quote" data-quote>
          <div class="quote__card">
            <blockquote data-q></blockquote>
            <figcaption data-by></figcaption>
          </div>
          <button type="button" class="quote__next" data-next><span data-count>1 / 4</span> · Next →</button>
        </figure>
      </div>
      <p class="reviews__note">&#9733;&#9733;&#9733;&#9733;&#9733; · 612 Google reviews</p>
    </section>

    <!-- 10. Find the chair -->
    <section class="sec sec--dark visit" id="visit" data-visit>
      <div class="visit__grid">
        <div class="visit__info">
          <h2 class="h2" data-reveal><span class="ln"><span class="l">Three shops,</span></span><span class="ln"><span class="b">near a Tube.</span></span></h2>
          <div class="visit__tabs" role="group" aria-label="Choose a shop">
            {shops.map((s, i) => <button type="button" class={`chip${i === 0 ? ' is-on' : ''}`} data-shop-tab={s.id} aria-pressed={i === 0 ? 'true' : 'false'}>{s.name}</button>)}
          </div>
          <address class="visit__addr"><span data-s-street></span><br /><span data-s-area></span><br /><a data-s-phone href="#"></a></address>
          <dl class="visit__hours" data-s-hours></dl>
          <p class="visit__walkins" data-s-walkins></p>
          <button type="button" class="book-pill" data-s-book>Book here <i aria-hidden="true">↗</i></button>
        </div>
        <div class="visit__mapwrap">
          <svg class="visit__map" viewBox="0 0 600 460" role="img" aria-label="A stylised street map with a walking route from the Tube to the shop" data-map>
            <g class="map__roads" data-roads></g>
            <path class="map__route" data-route d="" fill="none" stroke="#efeeea" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
            <circle class="map__stn" data-stn r="9" fill="#0b0b0c" stroke="#efeeea" stroke-width="3" />
            <text class="map__lbl" data-stn-lbl x="0" y="0"></text>
            <circle class="map__pin" data-pin r="20" fill="#efeeea" />
            <text class="map__lbl map__lbl--pin" data-pin-lbl x="0" y="0">SIDECUT</text>
          </svg>
          <p class="visit__walk" data-s-walk></p>
        </div>
      </div>
    </section>

    <!-- 11. FAQ and hiring -->
    <section class="sec sec--dark faq">
      <h2 class="faq__title"><span class="l">Before</span> <span class="b">you book</span></h2>
      <div class="faq__list">
        {faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
      <div class="hire">
        <svg width="22" height="22" viewBox="0 0 28 22" fill="none" aria-hidden="true"><path d={mark} stroke="currentColor" stroke-width="2.4" stroke-linecap="round" /></svg>
        <p>Now hiring: <strong>two chairs to rent</strong> &middot; steady clientele, your hours, your book.</p>
        <a class="pill pill--light" href={`mailto:${contact.email}`}>Apply</a>
      </div>
    </section>
  </main>

  <footer class="foot sec sec--dark">
    <div class="foot__free">
      <p class="foot__line">The chair is free <b>at <span data-free>2:40 PM</span>.</b></p>
      <button class="book-pill book-pill--lg" type="button" data-book>Book a chair <i aria-hidden="true">↗</i></button>
    </div>
    <p class="foot__word" data-word aria-label="side cut"><span class="foot__a">side</span> <span class="foot__b">cut</span></p>
    <div class="foot__cols">
      <nav class="foot__nav" aria-label="Footer">
        {nav.map((l) => <a href={l.href}>{l.label}</a>)}
        <a href={`mailto:${contact.email}`}>Email</a>
      </nav>
    </div>
  </footer>

  <aside class="drawer" data-drawer aria-hidden="true" aria-label="Booking">
    <div class="drawer__scrim" data-close></div>
    <div class="drawer__panel" role="dialog" aria-modal="true">
      <button class="drawer__x" type="button" data-close aria-label="Close booking">×</button>
      <div class="drawer__body" data-body></div>
      <div class="drawer__bar" data-bar>
        <span class="drawer__sum" data-sum>Nothing picked yet</span>
        <span class="drawer__btns"><button type="button" class="link" data-back hidden>Back</button><button type="button" class="pill pill--light" data-continue disabled>Continue</button></span>
      </div>
    </div>
  </aside>
  <div class="toast" data-toast role="status" aria-live="polite"></div>
  <div class="fadewipe" data-fadewipe aria-hidden="true"></div>

  <script type="application/json" id="data" set:html={JSON.stringify(data)}></script>
  <script>
    import '../scripts/main';
  </script>
</body>
</html>
