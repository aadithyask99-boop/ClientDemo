---
import { manifesto } from '../data/content';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const props = [
  { n: 'lock', cls: 'prop--lock', depth: 1.0 },
  { n: 'shield', cls: 'prop--shield', depth: 0.8 },
  { n: 'key', cls: 'prop--key', depth: 1.25 },
  { n: 'orb', cls: 'prop--orb', depth: 0.9 },
];
---

<section class="mani" data-mani aria-labelledby="mani-title">
  <h2 id="mani-title" class="sr-only">{manifesto.join(' ')}</h2>
  <canvas class="mani__dots" data-dots data-lines={JSON.stringify(manifesto)} aria-hidden="true"></canvas>
  <div class="mani__props" aria-hidden="true">
    {props.map((p) => (
      <div class:list={['prop', p.cls]} data-prop data-depth={p.depth}>
        <img src={`${base}/img/props/${p.n}.webp`} width="640" height="640" alt="" loading="lazy" />
      </div>
    ))}
  </div>
</section>
