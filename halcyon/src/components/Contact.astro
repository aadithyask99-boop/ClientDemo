      <div><dt>SOCIAL</dt><dd><a href="#">LINKEDIN</a><a href="#">GITHUB</a><a href="#">X</a></dd></div>
      <div><dt>CONTACT</dt><dd><span>hello@halcyon.example</span><span>+00 000 000 0000</span></dd></div>
    </dl>
  </div>
  <div class="contact__keys" data-keys aria-hidden="true"></div>
  <p class="contact__legal mono"><span>&copy; 2026 HALCYON</span><span>CALM, BY DESIGN</span></p>
