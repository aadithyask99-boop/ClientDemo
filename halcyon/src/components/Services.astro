---
import { services } from '../data/content';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="svc" id="services" data-svc aria-label="Services">
  <p class="mono svc__label">[ SERVICES ]</p>
  <ul class="svc__list" data-svc-list>
    {services.map((s) => (
      <li class="svc__item" data-svc-item data-img={s.img} tabindex="0">
        <span class="svc__row">
          <span class="svc__name">{s.name}</span>
          <span class="mono svc__cap">{s.caption}</span>
        </span>
      </li>
    ))}
  </ul>
  <div class="svc__thumb" data-svc-thumb aria-hidden="true">
    {services.map((s) => <img src={`${base}/img/services/${s.img}.webp`} data-thumb={s.img} width="900" height="675" alt="" loading="lazy" />)}
  </div>
</section>
