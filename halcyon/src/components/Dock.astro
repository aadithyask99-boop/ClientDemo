---
const links = [
  ['HOME', '#top'],
  ['ABOUT', '#about'],
  ['SERVICES', '#services'],
  ['INDUSTRIES', '#industries'],
  ['THREAT INTELLIGENCE', '#work'],
  ['CONTACT', '#contact'],
];
---

<!-- Full-screen menu for small screens. The nav itself lives in Header.astro and stays fixed on every screen size. -->
<div class="menu" id="menu" data-menu hidden>
  <nav class="menu__nav" aria-label="Menu">
    {links.map(([label, href]) => <a href={href} data-menu-link>{label}</a>)}
  </nav>
  <p class="mono menu__note">HALCYON &middot; CALM, BY DESIGN</p>
</div>
