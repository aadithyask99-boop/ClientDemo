---
const links = ['HOME', 'WORK', 'SERVICES', 'CONTACT'];
---

<div class="pillbar" data-dock>
  <a class="pillbar__pill pillbar__pill--talk" href="#contact">Let's talk <span class="pillbar__dot" aria-hidden="true"></span></a>
  <a class="pillbar__logo" href="#" aria-label="Halcyon, top">
    <svg viewBox="0 0 40 24" width="34" height="21" aria-hidden="true"><path d="M1 14c7-1 11-5 15-11 1.6 4 4.4 6.6 9 7.6 5 1.100 9.600-.4 14-3-1.600 6-6.200 10.600-13 11.600-4.500.7-8 .1-11-1.600-3 3.700-8 5.600-14 4.400z" fill="currentColor"/></svg>
  </a>
  <button class="pillbar__pill pillbar__pill--menu" type="button" aria-expanded="false" aria-controls="menu" data-menu-btn>Menu <span class="pillbar__dot pillbar__dot--dark" aria-hidden="true"></span></button>
</div>

<div class="menu" id="menu" data-menu hidden>
  <nav class="menu__nav" aria-label="Menu">
    {links.map((l) => <a href={l === 'CONTACT' ? '#contact' : '#'} data-menu-link>{l}</a>)}
  </nav>
  <p class="mono menu__note">HALCYON &middot; CALM, BY DESIGN</p>
</div>
