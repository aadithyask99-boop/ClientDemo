---
const links = [
  { label: 'home', href: '#top' },
  { label: 'about', href: '#about' },
  { label: 'services', href: '#services' },
  { label: 'industries', href: '#industries' },
  { label: 'threat intelligence', href: '#work' },
  { label: 'contact', href: '#contact' },
];
---

<header class="nav" data-nav>
  <a class="nav__brand" href="#top" aria-label="Halcyon, home" data-reveal>
    <svg viewBox="0 0 40 24" width="38" height="23" aria-hidden="true">
      <path d="M1 14c7-1 11-5 15-11 1.6 4 4.4 6.6 9 7.6 5 1.100 9.600-.4 14-3-1.600 6-6.200 10.600-13 11.600-4.500.7-8 .1-11-1.600-3 3.700-8 5.600-14 4.400z" fill="currentColor"/>
    </svg>
    <span>Halcyon</span>
  </a>
  <nav class="nav__links" aria-label="Main" data-reveal>
    {links.map((l) => (
      <a href={l.href} class:list={['nav__link', { 'is-current': l.href === '#top' }]} data-nav-link aria-current={l.href === '#top' ? 'page' : undefined}>{l.label}</a>
    ))}
  </nav>
  <a class="nav__cta" href="#contact" data-reveal>Resources</a>
  <button class="nav__menu" type="button" aria-expanded="false" aria-controls="menu" data-menu-btn data-reveal>Menu <span class="nav__dot" aria-hidden="true"></span></button>
</header>
