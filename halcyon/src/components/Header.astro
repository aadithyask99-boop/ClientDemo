---
const links = [
  { label: 'home', href: '#', current: true },
  { label: 'about', href: '#' },
  { label: 'services', href: '#' },
  { label: 'industries', href: '#' },
  { label: 'threat intelligence', href: '#' },
  { label: 'contact', href: '#' },
];
---

<header class="nav" data-nav>
  <a class="nav__brand" href="#" aria-label="Halcyon, home" data-reveal>
    <svg viewBox="0 0 40 24" width="38" height="23" aria-hidden="true">
      <path d="M1 14c7-1 11-5 15-11 1.6 4 4.4 6.6 9 7.6 5 1.1 9.600-.4 14-3-1.600 6-6.200 10.600-13 11.600-4.500.7-8 .1-11-1.600-3 3.700-8 5.600-14 4.400z" fill="currentColor"/>
    </svg>
    <span>Halcyon</span>
  </a>
  <nav class="nav__links" aria-label="Main">
    {links.map((l) => (
      <a href={l.href} class:list={['nav__link', { 'is-current': l.current }]} aria-current={l.current ? 'page' : undefined} data-reveal>{l.label}</a>
    ))}
  </nav>
  <a class="nav__cta" href="#" data-reveal>Resources</a>
</header>
