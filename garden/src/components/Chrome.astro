---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Page furniture: the thread, fireflies, sound and night buttons, and the toast.
---
<svg class="thread" id="thread" aria-hidden="true" preserveAspectRatio="none">
  <path id="thread-ghost" fill="none" />
  <path id="thread-line" fill="none" />
  <g id="needle"><path d="M0 0l24 -3l-2 3l2 3z" /><circle cx="3" cy="0" r="1.3" /></g>
</svg>
<div class="dapple" aria-hidden="true">
  <svg class="d1" viewBox="0 0 900 900" preserveAspectRatio="xMidYMid slice"><defs><filter id="soft1"><feGaussianBlur stdDeviation="16" /></filter></defs><g filter="url(#soft1)"><path transform="translate(407 504) rotate(333) scale(1.21)" d="M0 0C40-34 100-34 130 0C100 34 40 34 0 0Z"/><path transform="translate(457 529) rotate(66) scale(1.26)" d="M0 0C40-34 100-34 130 0C100 34 40 34 0 0Z"/><path transform="translate(567 714) rotate(34) scale(1.03)" d="M0 0C40-34 100-34 130 0C100 34 40 34 0 0Z"/><path transform="translate(82 729) rotate(250) scale(0.75)" d="M0 0C40-34 100-34 130 0C100 34 40 34 0 0Z"/><path transform="translate(884 868) rotate(235) scale(1.38)" d="M0 0C40-34 100-34 130 0C100 34 40 34 0 0Z"/><path transform="translate(142 14) rotate(190) scale(0.77)" d="M0 0C40-34 100-34 130 0C100 34 40 34 0 0Z"/><path transform="translate(171 218) rotate(11) scale(1.21)" d="M0 0C40-34 100-34 130 0C100 34 40 34 0 0Z"/><path transform="translate(396 758) rotate(187) scale(1.40)" d="M0 0C40-34 100-34 130 0C100 34 40 34 0 0Z"/><path transform="translate(450 596) rotate(165) scale(1.01)" d="M0 0C40-34 100-34 130 0C100 34 40 34 0 0Z"/><path transform="translate(898 896) rotate(302) scale(1.48)" d="M0 0C40-34 100-34 130 0C100 34 40 34 0 0Z"/><path transform="translate(284 207) rotate(104) scale(0.78)" d="M0 0C40-34 100-34 130 0C100 34 40 34 0 0Z"/><path transform="translate(690 360) rotate(305) scale(1.13)" d="M0 0C40-34 100-34 130 0C100 34 40 34 0 0Z"/><path transform="translate(862 763) rotate(0) scale(0.93)" d="M0 0C40-34 100-34 130 0C100 34 40 34 0 0Z"/><path transform="translate(819 423) rotate(353) scale(1.14)" d="M0 0C40-34 100-34 130 0C100 34 40 34 0 0Z"/><path transform="translate(66 567) rotate(280) scale(1.00)" d="M0 0C40-34 100-34 130 0C100 34 40 34 0 0Z"/></g></svg>
  <svg class="d2" viewBox="0 0 900 900" preserveAspectRatio="xMidYMid slice"><defs><filter id="soft2"><feGaussianBlur stdDeviation="26" /></filter></defs><g filter="url(#soft2)"><path transform="translate(78 299) rotate(347) scale(1.53)" d="M0 0C40-34 100-34 130 0C100 34 40 34 0 0Z"/><path transform="translate(106 222) rotate(36) scale(0.77)" d="M0 0C40-34 100-34 130 0C100 34 40 34 0 0Z"/><path transform="translate(717 160) rotate(201) scale(1.19)" d="M0 0C40-34 100-34 130 0C100 34 40 34 0 0Z"/><path transform="translate(172 659) rotate(47) scale(1.41)" d="M0 0C40-34 100-34 130 0C100 34 40 34 0 0Z"/><path transform="translate(105 379) rotate(77) scale(1.00)" d="M0 0C40-34 100-34 130 0C100 34 40 34 0 0Z"/><path transform="translate(874 723) rotate(109) scale(1.67)" d="M0 0C40-34 100-34 130 0C100 34 40 34 0 0Z"/><path transform="translate(190 355) rotate(308) scale(1.41)" d="M0 0C40-34 100-34 130 0C100 34 40 34 0 0Z"/><path transform="translate(90 890) rotate(77) scale(0.98)" d="M0 0C40-34 100-34 130 0C100 34 40 34 0 0Z"/><path transform="translate(695 296) rotate(107) scale(0.78)" d="M0 0C40-34 100-34 130 0C100 34 40 34 0 0Z"/><path transform="translate(81 524) rotate(87) scale(1.36)" d="M0 0C40-34 100-34 130 0C100 34 40 34 0 0Z"/><path transform="translate(335 408) rotate(345) scale(1.23)" d="M0 0C40-34 100-34 130 0C100 34 40 34 0 0Z"/></g></svg>
</div>
<div class="vines" aria-hidden="true">
  <div class="vine vl"><img src={`${base}/art/vine.webp`} alt="" width="424" height="1100" /><img class="flip" src={`${base}/art/vine.webp`} alt="" width="424" height="1100" /><img src={`${base}/art/vine.webp`} alt="" width="424" height="1100" /></div>
  <div class="vine vr"><img src={`${base}/art/vine.webp`} alt="" width="424" height="1100" /><img class="flip" src={`${base}/art/vine.webp`} alt="" width="424" height="1100" /><img src={`${base}/art/vine.webp`} alt="" width="424" height="1100" /></div>
</div>
<canvas class="petals" id="petals" aria-hidden="true"></canvas>
<canvas class="fireflies" id="fireflies" aria-hidden="true"></canvas>
<div class="dock" id="dock">
  <button class="round" id="sound" type="button" aria-pressed="false" aria-label="Turn sound on"><i></i><i></i><i></i></button>
  <button class="round" id="nightbtn" type="button" aria-pressed="false" aria-label="Switch between day and night">
    <svg viewBox="0 0 48 48" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M31 7a17 17 0 1 0 10 26A15 15 0 0 1 31 7z"/></svg>
  </button>
</div>
<div class="toast" id="toast" role="status" aria-live="polite" hidden></div>
