---
import { invitation as inv } from '../data/invitation';
---
<section class="dress" id="dress">
  <h2 class="reveal">{inv.dress.code}</h2>
  <p class="reveal">{inv.dress.note}</p>
  <div class="swatches reveal" role="group" aria-label="Colour palette. Tap each colour to hear it.">
    {inv.dress.swatches.map((c, i) => (
      <button class="swatch" type="button" data-note={i} style={`--c:${c}`} aria-label={`Colour ${i + 1}`}></button>
    ))}
    <button class="ring-egg" data-ring="4" style="--x:calc(100% - 2.6rem);--y:-2.6rem" aria-label="A tiny hidden ring">
      <svg viewBox="0 0 48 48" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2.4"><circle cx="24" cy="29" r="11"/><path d="M24 6l5 6-5 6-5-6z"/></svg>
    </button>
  </div>
  <p class="hint script reveal">tap the colours</p>
</section>
