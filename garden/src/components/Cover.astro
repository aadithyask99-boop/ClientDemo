---
import { invitation as inv } from '../data/invitation';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const initials = `${inv.a[0]}&${inv.b[0]}`;
---
<!-- Only shown with JavaScript on (the .js class); tapping the seal opens the doors. -->
<div class="cover" id="cover" aria-live="polite">
  <div class="doors">
    <div class="door door-l" style={`--img:url(${base}/art/linen.webp)`}></div>
    <div class="door door-r" style={`--img:url(${base}/art/linen.webp)`}></div>
  </div>
  <!-- A gold thread is wrapped across both doors and tied in a bow under the wax seal. Tapping the seal unties it. -->
  <svg class="cord" viewBox="0 0 1000 60" preserveAspectRatio="none" aria-hidden="true">
    <path class="cs" pathLength="100" d="M500 31 C 400 28, 250 37, -20 31" />
    <path class="cs" pathLength="100" d="M500 31 C 600 34, 750 25, 1020 31" />
    <path class="ch" pathLength="100" d="M500 29.4 C 400 26.4, 250 35.4, -20 29.4" />
    <path class="ch" pathLength="100" d="M500 29.4 C 600 32.4, 750 23.4, 1020 29.4" />
  </svg>
  <svg class="knot-svg" viewBox="0 0 200 200" aria-hidden="true">
    <path class="loop" d="M100 100 C 70 58, 16 68, 24 102 C 30 130, 80 120, 100 100" />
    <path class="loop" d="M100 100 C 130 58, 184 68, 176 102 C 170 130, 120 120, 100 100" />
    <path class="tail t1" pathLength="100" d="M97 104 C 92 140, 80 168, 62 196" />
    <path class="tail t2" pathLength="100" d="M103 104 C 110 140, 122 170, 140 198" />
  </svg>
  <button class="seal" id="seal" type="button" aria-label={`Open the invitation from ${inv.a} and ${inv.b}`}>
    <img src={`${base}/art/seal.webp`} alt="" width="340" height="340" decoding="async" />
    <span class="seal-mono">{initials}</span>
  </button>
  <p class="cover-hint script">touch the seal to open</p>
  <p class="secret" id="secret" role="status" hidden></p>
</div>
