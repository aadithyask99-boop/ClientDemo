---
import { invitation as inv } from '../data/invitation';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section class="welcome" id="welcome" data-knot>
  <div class="wreath reveal">
    <img src={`${base}/art/arch.webp`} alt="" width="1400" height="1867" loading="lazy" decoding="async" />
    <div class="wreath-in">
      <p class="hello" id="hello">Welcome</p>
      <p class="seat script" id="seat">we saved you a seat</p>
    </div>
  </div>
  <p class="families reveal">{inv.families}</p>
  <p class="lede reveal">{inv.welcome}</p>
</section>
