---
import Icon from './Icon.astro';
import { invitation as inv } from '../data/invitation';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section class="venue band band-green" id="venue" data-knot style={`--img:url(${base}/art/linen.webp)`}>
  <div class="vista reveal">
    <img src={`${base}/art/venue.webp`} alt="An embroidered glass orangery in a walled rose garden at dusk" width="900" height="1200" loading="lazy" decoding="async" />
    <button class="ring-egg" data-ring="3" style="--x:50%;--y:82%" aria-label="A tiny hidden ring">
      <svg viewBox="0 0 48 48" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2.4"><circle cx="24" cy="29" r="11"/><path d="M24 6l5 6-5 6-5-6z"/></svg>
    </button>
  </div>
  <div class="vcopy reveal">
    <h2>{inv.venue.name}</h2>
    <p class="place script">{inv.venue.place}</p>
    <p>{inv.venue.note}</p>
    <div class="actions">
      <a class="pill" href={inv.venue.mapUrl} target="_blank" rel="noopener"><Icon name="pin" size={20} />Find your way</a>
      <button class="pill ghost" id="ics" type="button"><Icon name="calendar" size={20} />Add to calendar</button>
    </div>
  </div>
</section>
