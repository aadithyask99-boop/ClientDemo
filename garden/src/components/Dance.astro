---
import { invitation as inv } from '../data/invitation';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section class="dance" id="dance" data-knot>
  <div class="dance-pin">
    <h2>{inv.dance.title}</h2>
    <!-- The couple waltz inside an embroidery hoop: scroll scrubs the dance, press and hold plays it. -->
    <div class="hoop-stage" id="hoop" data-hold={inv.dance.holdHint}>
      <img class="still" src={`${base}/art/couple.webp`} alt="An embroidered bride and groom about to dance" width="720" height="960" loading="lazy" decoding="async" />
      <canvas id="dance-canvas" width="400" height="534" aria-hidden="true"></canvas>
    </div>
    <p class="hint script" id="dance-hint" data-rest={inv.dance.hint}>{inv.dance.hint}</p>
  </div>
</section>
