---
import '@fontsource/oswald/700.css';
import '@fontsource/merriweather/300.css';
import '../styles/global.css';
import { brand, pairs, ink, services, areas, hours, statement, merch, wall, foods, heroLinks, footerLinks, note, credits } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const img = (f: string) => `${base}/img/${f}`;
const art = (f: string) => `${base}/art/${f}`;

// sunburst: 64 rays of two lengths
const rays = Array.from({ length: 64 }, (_, i) => {
  const a = (i / 64) * Math.PI * 2;
  const r1 = 62, r2 = i % 2 ? 80 : 94;
  return { x1: 100 + Math.cos(a) * r1, y1: 100 + Math.sin(a) * r1, x2: 100 + Math.cos(a) * r2, y2: 100 + Math.sin(a) * r2 };
});

const marquee = areas.map((a) => ({ name: a.name, food: a.food }));
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{brand.title}</title>
  <meta name="description" content={brand.description} />
  <meta name="theme-color" content="#F6F1E6" />
  <link rel="icon" href={`data:image/svg+xml,${encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><rect width="64" height="64" rx="14" fill="#0E5A3A"/><text x="32" y="47" font-family="Impact,Oswald,sans-serif" font-size="44" font-weight="700" fill="#CFEBD9" text-anchor="middle">M</text></svg>')}`} />
  <link rel="preload" href={art('wordmark.png')} as="image" />
  <link rel="preload" href={art('mascot-sprite.png')} as="image" />
  <script is:inline>document.documentElement.classList.add('js');try{if(sessionStorage.getItem('mld-seen')||matchMedia('(prefers-reduced-motion: reduce)').matches){document.documentElement.classList.add('no-loader')}}catch(e){}</script>
</head>
<body style={`--art-wordmark:url(${art('wordmark.png')});--art-mascot:url(${art('mascot-sprite.png')});--ink:${ink}`}>

<!-- Loader: nine colour curtains, one per area -->
<div class="loader" aria-hidden="true" data-loader>
  {[...areas].reverse().map((a, i) => (
    <div class="loader__item" style={`--l:${pairs[i % pairs.length].light};--d:${pairs[i % pairs.length].dark}`}><span>{a.name}</span></div>
  ))}
</div>

<!-- Menu overlay: areas, then sites -->
<section class="menu" data-menu aria-label="Find your Maledetta" aria-hidden="true">
  <button class="menu__close" type="button" data-menu-close>Close</button>
  <div class="menu__scroll" data-menu-scroll>
    <ul class="menu__list">
      {areas.map((a, i) => (
        <li class="area" data-area>
          <button class="area__name" type="button" aria-expanded="false"><span class="area__mask"><span class="area__text">{a.name}</span></span><svg class="chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3l9 9-9 9" fill="none" stroke="currentColor" stroke-width="2.4" /></svg></button>
          <div class="area__sites">
            <div class="site" data-site>
              <button class="site__row" type="button"><span class="site__name">Maledetta {a.name}</span><span class="site__street">{a.street}</span></button>
              <div class="site__banner">
                <img src={img(a.img)} alt="" loading="lazy" decoding="async" />
                <div class="site__shade"></div>
                <div class="site__detail">
                  <h3>Maledetta<br />{a.name}</h3>
                  <p>{a.street}<br />{a.phone}</p>
                  <ul>{hours.map((h) => <li>{h}</li>)}</ul>
                  <a class="btn" href="mailto:hello@maledetta.example?subject=Table at Maledetta">Book a table</a>
                  <button type="button" class="site__back" data-site-back>Back</button>
                </div>
                <div class="cursor" data-cursor aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" /></svg></div>
              </div>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<main id="top" data-main>
  <!-- 1. Hero -->
  <header class="hero" data-hero>
    <h1 class="sr">Maledetta</h1>
    <div class="wordmark" aria-hidden="true" data-wordmark></div>
    <button class="mascot" type="button" tabindex="-1" aria-label="Maledetta mascot. Press for a bite." data-mascot><span class="mascot__art"></span></button>
    <div class="anchor anchor--hero" data-anchor="hero">
      <button class="sticker" type="button" data-sticker aria-label="Find my local Maledetta" aria-haspopup="dialog">
        <svg class="sticker__door" viewBox="0 0 40 60" aria-hidden="true"><path d="M4 56V10h32v46" fill="none" stroke="currentColor" stroke-width="3.2" /><path d="M2 10h36" stroke="currentColor" stroke-width="4" /><rect x="9" y="16" width="9" height="12" fill="currentColor" /><rect x="22" y="16" width="9" height="12" fill="currentColor" /><rect x="9" y="33" width="9" height="19" fill="currentColor" /><rect x="22" y="33" width="9" height="19" fill="currentColor" /></svg>
        <span class="sticker__text"><span>{brand.sticker[0]}</span><span>{brand.sticker[1]}</span></span>
      </button>
    </div>
    <nav class="hero__nav" aria-label="Secondary">
      {heroLinks.map((l) => <a class="small-link" href={l.href}>{l.label}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3l9 9-9 9" fill="none" stroke="currentColor" stroke-width="1.8" /></svg></a>)}
      <div class="social">
        <a href="#" aria-label="Instagram"><svg viewBox="0 0 32 32"><rect width="32" height="32" rx="8" fill="currentColor" /><rect x="7.5" y="7.5" width="17" height="17" rx="5" fill="none" stroke="var(--bg-i)" stroke-width="2.4" /><circle cx="16" cy="16" r="4" fill="none" stroke="var(--bg-i)" stroke-width="2.4" /><circle cx="21.5" cy="10.5" r="1.3" fill="var(--bg-i)" /></svg></a>
        <a href="#" aria-label="TikTok"><svg viewBox="0 0 32 32"><rect width="32" height="32" rx="8" fill="currentColor" /><path d="M17.5 7v12.2a3.4 3.4 0 1 1-3.4-3.4M17.5 7c.3 2.6 2 4.2 4.6 4.4" fill="none" stroke="var(--bg-i)" stroke-width="2.6" stroke-linecap="round" /></svg></a>
        <a href="#" aria-label="Facebook"><svg viewBox="0 0 32 32"><rect width="32" height="32" rx="8" fill="currentColor" /><path d="M18 27V17h3.4l.6-4H18v-2.2c0-1.2.5-1.9 2-1.9h2V5.3C21.600 5.2 20.500 5 19.200 5 16 5 14 7 14 10.300V13h-3.400v4H14v10z" fill="var(--bg-i)" /></svg></a>
      </div>
    </nav>
  </header>

  <!-- 2. Services strip -->
  <section class="services" data-flip="1" aria-label="How to enjoy Maledetta">
    {services.map((s) => (
      <div class="svc" style={`--f:${s.flex}`}>
        {s.action === 'menu' ? <button type="button" class="svc__label" data-open-menu><h2>{s.label}</h2><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3l9 9-9 9" fill="none" stroke="currentColor" stroke-width="2.4" /></svg></button>
          : <a class="svc__label" href={s.href}><h2>{s.label}</h2><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3l9 9-9 9" fill="none" stroke="currentColor" stroke-width="2.4" /></svg></a>}
        <div class="svc__img"><img src={img(s.img)} alt={s.alt} style={`object-position:${s.pos}`} loading="lazy" decoding="async" /></div>
      </div>
    ))}
  </section>

  <!-- 3. Marquee + statement -->
  <section class="band" aria-label="About Maledetta">
    <div class="marquee" data-marquee aria-hidden="true">
      <div class="marquee__track" data-track>
        {[0, 1].map(() => (
          <div class="marquee__set">
            {marquee.map((m) => (<><span class="marquee__name">{m.name}</span><img class="marquee__food" src={art(`food-${m.food}.webp`)} alt="" loading="lazy" decoding="async" /></>))}
          </div>
        ))}
      </div>
    </div>
    <div class="band__body">
      <div class="band__text" data-reveal>
        {statement.map((t) => <p>{t}</p>)}
      </div>
      <div class="sunburst" data-sunburst>
        <svg viewBox="0 0 200 200" aria-hidden="true" data-rays>{rays.map((r) => <line x1={r.x1} y1={r.y1} x2={r.x2} y2={r.y2} />)}</svg>
        <button class="sunburst__hit" type="button" aria-label="Change the colours" data-palette-btn></button>
        <div class="anchor anchor--star" data-anchor="star"></div>
      </div>
    </div>
  </section>

  <!-- 4. Shop -->
  <section class="shop" id="shop" data-flip="2">
    <div class="shop__grid">
      <div class="shop__img"><img src={img(merch.img)} alt={merch.alt} loading="lazy" decoding="async" /></div>
      <div class="shop__text">
        <h2 data-reveal>{merch.heading}</h2>
        <p>{merch.body}</p>
        <a class="btn btn--dark" href="#shop">{merch.cta}</a>
      </div>
      <div class="anchor anchor--shop" data-anchor="shop"></div>
    </div>
  </section>

  <!-- 5. Wall of love -->
  <section class="wall" data-flip="3" aria-label="Wall of love">
    <div class="wall__word" aria-hidden="true"><span>Wall</span><span>of</span><span>Love</span></div>
    {wall.map((w) => (
      <figure class="print" data-speed={w.speed} style={`left:${w.x}vw;top:${w.y}vw;--w:${w.w}vw`}><img src={img(w.img)} alt={w.alt} width="900" height="1125" decoding="async" /></figure>
    ))}
    <div class="anchor anchor--wall" data-anchor="wall"></div>
  </section>

  <!-- 6. Tagline -->
  <section class="tagline"><p data-reveal>{brand.tagline[0]}<br />{brand.tagline[1]}</p></section>
</main>

<!-- 7. Footer -->
<footer class="footer" id="footer">
  <div class="footer__links">
    {footerLinks.map((l) => <a class="small-link small-link--light" href={l.href}>{l.label}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3l9 9-9 9" fill="none" stroke="currentColor" stroke-width="1.8" /></svg></a>)}
  </div>
  <div class="band band--footer">
    <div class="marquee" data-marquee data-reverse aria-hidden="true">
      <div class="marquee__track" data-track>
        {[0, 1].map(() => (
          <div class="marquee__set">
            {[...marquee].reverse().map((m) => (<><span class="marquee__name">{m.name}</span><img class="marquee__food" src={art(`food-${m.food}.webp`)} alt="" loading="lazy" decoding="async" /></>))}
          </div>
        ))}
      </div>
    </div>
  </div>
  <div class="hero hero--footer" data-footer-hero>
    <div class="wordmark" aria-hidden="true"></div>
    <div class="mascot mascot--static" aria-hidden="true"><span class="mascot__art"></span></div>
    <div class="anchor anchor--hero" data-anchor="footer"></div>
    <nav class="hero__nav" aria-label="Footer">
      <a class="small-link" href="#top" data-top>Back to top<svg viewBox="0 0 24 24" aria-hidden="true" style="transform:rotate(-90deg)"><path d="M8 3l9 9-9 9" fill="none" stroke="currentColor" stroke-width="1.8" /></svg></a>
      <a class="small-link" href="mailto:hello@maledetta.example">Private dining<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3l9 9-9 9" fill="none" stroke="currentColor" stroke-width="1.8" /></svg></a>
      <div class="social">
        <a href="#" aria-label="Instagram"><svg viewBox="0 0 32 32"><rect width="32" height="32" rx="8" fill="currentColor" /><rect x="7.5" y="7.5" width="17" height="17" rx="5" fill="none" stroke="var(--bg-i)" stroke-width="2.4" /><circle cx="16" cy="16" r="4" fill="none" stroke="var(--bg-i)" stroke-width="2.4" /><circle cx="21.5" cy="10.5" r="1.3" fill="var(--bg-i)" /></svg></a>
        <a href="#" aria-label="TikTok"><svg viewBox="0 0 32 32"><rect width="32" height="32" rx="8" fill="currentColor" /><path d="M17.5 7v12.2a3.4 3.4 0 1 1-3.4-3.4M17.5 7c.3 2.6 2 4.2 4.6 4.4" fill="none" stroke="var(--bg-i)" stroke-width="2.6" stroke-linecap="round" /></svg></a>
        <a href="#" aria-label="Facebook"><svg viewBox="0 0 32 32"><rect width="32" height="32" rx="8" fill="currentColor" /><path d="M18 27V17h3.4l.6-4H18v-2.2c0-1.2.5-1.9 2-1.9h2V5.3C21.600 5.2 20.500 5 19.200 5 16 5 14 7 14 10.300V13h-3.400v4H14v10z" fill="var(--bg-i)" /></svg></a>
      </div>
    </nav>
    <p class="note">{note}</p>
  </div>
</footer>

<div class="rain" data-rain aria-hidden="true" data-srcs={JSON.stringify(foods.map((f) => art(`food-${f}.webp`)))}></div>
<script type="application/json" id="pairs" set:html={JSON.stringify(pairs)}></script>
<script>
  import '../scripts/main.ts';
</script>
<!-- Photo credits: {credits.map((c) => `${c.photographer} (${c.link})`).join('; ')} -->
</body>
</html>
