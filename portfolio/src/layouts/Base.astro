---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import { site, description as defaultDescription } from '../data/site';
import Pixel from '../components/Pixel.astro';
// Preloaded so the headline font is fetched in parallel with the CSS instead of after it (the intro waits for fonts)
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
}
const { title = `${site.owner} · ${site.role}`, description = defaultDescription } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, `${site.url}/`).href;
const ogImage = `${site.url}${base}/og.png`;

const person = `${site.url}/#person`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': person,
      name: site.owner,
      jobTitle: site.role,
      url: site.url,
      ...(site.email ? { email: `mailto:${site.email}` } : {}),
      ...(site.socials.length ? { sameAs: site.socials.map((s) => s.href) } : {}),
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${site.url}/#service`,
      name: site.brand,
      url: site.url,
      founder: { '@id': person },
      areaServed: 'Worldwide',
      serviceType: ['Web design', 'Web development', 'Search engine optimisation', 'Digital marketing'],
    },
    { '@type': 'WebSite', '@id': `${site.url}/#website`, url: site.url, name: site.brand, inLanguage: 'en' },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#fbf6ee" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={site.noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <link rel="preload" as="font" type="font/woff2" href={geistLatin} crossorigin />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    <link rel="author" href={`${base}/humans.txt`} />
    {site.gscVerification && <meta name="google-site-verification" content={site.gscVerification} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <script is:inline>
      // The page is complete and readable without JavaScript. The js class only switches the intro on.
      (function () {
        var d = document.documentElement;
        // A reload always starts at the top, on the hero, not wherever the browser remembers (the intro is built for the top of the page)
        try {
          if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
          if (location.hash) history.replaceState(null, '', location.pathname + location.search);
        } catch (e) {}
        window.scrollTo(0, 0);
        window.addEventListener('load', function () { window.scrollTo(0, 0); });
        window.addEventListener('pageshow', function (e) { if (e.persisted) window.scrollTo(0, 0); });
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        d.classList.add('js');
        // A mouse or trackpad gets the full pointer effects (fx); phones and touch tablets get the light version
        if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) d.classList.add('fx');
        // If the script never started, never leave the page hidden
        window.setTimeout(function () {
          if (!window.__aadi) { d.classList.remove('js'); d.classList.remove('fx'); }
        }, 6000);
      })();
    </script>
  </head>
  <body>
    <div class="pre" data-pre aria-hidden="true"><Pixel class="pre__pixel" /></div>
    <slot />
    {site.cfToken && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: site.cfToken })}></script>}
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
