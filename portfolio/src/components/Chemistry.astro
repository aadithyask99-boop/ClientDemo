---
/* Site Chemistry.
   Scene one: a ring of ticks that swells toward the pointer. Scrolling, the orange core at the centre grows until it floods the screen,
   then the view pulls back to the whole diagram: four circles (design, build, SEO, marketing) and the one place they all meet.
   Without the scroll scene (touch, reduced motion, no JS) the finished diagram is simply shown. */
const N = 96;
const C = 338;
const R = 330;
const ticks = Array.from({ length: N }, (_, i) => {
  const a = (i / N) * Math.PI * 2;
  return { a, x1: C + R * Math.sin(a), y1: C - R * Math.cos(a), x2: C + (R - 9) * Math.sin(a), y2: C - (R - 9) * Math.cos(a) };
});

const r = 150; // circle radius
const d = 95; // how far each circle sits from the centre
const rad = (a: number) => (a * Math.PI) / 180;
const circles = [
  { id: 'design', cx: 0, cy: -d, out: -90, code: 'De', name: 'Design', arc: 'Layout | Motion | Taste', lx: 0, ly: -176 },
  { id: 'seo', cx: d, cy: 0, out: 0, code: 'Se', name: 'SEO', arc: 'Intent | Structure | Schema', lx: 176, ly: 0 },
  { id: 'marketing', cx: 0, cy: d, out: 90, code: 'Ma', name: 'Marketing', arc: 'Offer | Audience | Conversion', lx: 0, ly: 176 },
  { id: 'build', cx: -d, cy: 0, out: 180, code: 'Bu', name: 'Build', arc: 'Astro | Speed | Accessibility', lx: -176, ly: 0 },
];
/* Text runs along the outside of each circle. The bottom one runs the other way round so it still reads left to right. */
function arcPath(c: (typeof circles)[number]) {
  const reverse = c.id === 'marketing';
  const rt = r + (reverse ? 26 : 16);
  const span = 52;
  const p = (a: number) => `${(c.cx + rt * Math.cos(rad(a))).toFixed(2)} ${(c.cy + rt * Math.sin(rad(a))).toFixed(2)}`;
  const [from, to] = reverse ? [c.out + span, c.out - span] : [c.out - span, c.out + span];
  return `M${p(from)} A${rt} ${rt} 0 0 ${reverse ? 0 : 1} ${p(to)}`;
}
---

<section class="chem" id="service" data-world-section="dark" aria-labelledby="chem-title">
  <div class="chem__pin" data-chem-pin>
    <div class="chem__copy" data-chem-copy>
      <h2 id="chem-title" class="chem__title">Site Chemistry</h2>
      <p class="chem__sub">Design · Build · SEO · Marketing</p>
    </div>

    <div class="chem__stage">
      <svg class="chem__ring" data-ring viewBox="0 0 676 676" aria-hidden="true">
        {ticks.map((t) => <line data-a={t.a} x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} stroke="currentColor" stroke-width="2" />)}
      </svg>

      <svg
        class="venn"
        data-venn
        viewBox="-300 -300 600 600"
        role="img"
        aria-label="Four overlapping circles: design, build, SEO and marketing. Where all four meet: cool and found."
      >
        <defs>
          {circles.map((c) => <clipPath id={`clip-${c.id}`}><circle cx={c.cx} cy={c.cy} r={r} /></clipPath>)}
          {circles.map((c) => <path id={`arc-${c.id}`} d={arcPath(c)} />)}
        </defs>
        <g data-venn-body>
          {circles.map((c) => <circle class="venn__c" data-vc cx={c.cx} cy={c.cy} r={r} />)}
          <g clip-path="url(#clip-design)">
            <g clip-path="url(#clip-seo)">
              <g clip-path="url(#clip-marketing)">
                <g clip-path="url(#clip-build)">
                  <rect class="venn__core" data-vcore x="-300" y="-300" width="600" height="600" />
                </g>
              </g>
            </g>
          </g>
          {
            circles.map((c) => (
              <g data-vl>
                <text class="venn__code" x={c.lx} y={c.ly + 6} text-anchor="middle">{c.code}</text>
                <text class="venn__name" x={c.lx} y={c.ly + 26} text-anchor="middle">{c.name}</text>
              </g>
            ))
          }
          {
            circles.map((c) => (
              <text class="venn__arc" data-va>
                <textPath href={`#arc-${c.id}`} startOffset="50%" text-anchor="middle">{c.arc}</textPath>
              </text>
            ))
          }
          <g data-vm>
            <text class="venn__mid" x="0" y="-3" text-anchor="middle">COOL</text>
            <text class="venn__mid" x="0" y="11" text-anchor="middle">+ FOUND</text>
          </g>
        </g>
      </svg>
    </div>
  </div>
</section>
