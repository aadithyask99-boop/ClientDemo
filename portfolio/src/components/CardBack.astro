---
/* The face-down side of the cards: one symmetric pattern of little bevelled pixels (light edge top-left, dark edge bottom-right, so each block reads
   as raised). It is an image (public/card-back.svg), so the browser draws it once and reuses the picture instead of repainting 500 shapes per card. */
interface Props {
  side?: 'l' | 'r';
  class?: string;
}
const { side, class: cls = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class:list={['back', side && `back--${side}`, cls]} aria-hidden="true">
  <img src={`${base}/card-back.svg`} alt="" width="100" height="140" decoding="async" />
</div>
