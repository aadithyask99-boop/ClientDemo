---
import { site } from '../data/site';
/* The pricing sheet: opens from "Pricing" in the menu and from the footer (scripts/pricing.ts). It follows the reference: a flat cream sheet that rises over 80% of
   the screen (the top fifth stays showing), a big headline, one package in a row (name, what it is, price, two little looping clips) and a way to start.
   No boxes, no lines, no labels, no numbers. Click the big price for a small surprise. */
const ticks = Array.from({ length: 60 }, (_, i) => i);
const arrow = 'M110 47.42 66.064 95 54.92 83.702l26.108-27.848H0V38.987h81.028L54.92 11.139 66.064 0z';
const pages = ['Home', 'About us', 'Services', 'Contact us', 'Blog'];
---

<div class="pr" data-pricing hidden>
  <div class="pr__veil" data-pricing-close></div>
  <div class="pr__sheet" role="dialog" aria-modal="true" aria-labelledby="pr-title" tabindex="-1" data-lenis-prevent>
    <button class="pr__x" type="button" data-pricing-close>Close</button>

    <div class="pr__body">
      <h2 class="pr__title" id="pr-title" data-pr-in>Fair pricing. Your homepage first, payment second.</h2>

      <div class="pr__row" data-pr-in>
        <p class="pr__name">Five-page website</p>
        <div class="pr__info">
          <p class="pr__text">Bespoke and fully animated, with the SEO fundamentals done. {pages.join(', ').replace(/, ([^,]+)$/, ' and $1')}. Ready to go live.</p>
          <button class="pr__price" type="button" data-pricing-price>
            <span class="pr__amount">£1,299</span>
            <span class="pr__stamp" aria-hidden="true">£0 today<br /><small>pay when you love it</small></span>
          </button>
          <p class="pr__text">I design your homepage first. You only pay once you love it, then I build the rest.</p>
        </div>
        <div class="pr__clips" aria-hidden="true">
          <span class="pr__clip" data-pricing-clip="0"></span>
          <span class="pr__clip" data-pricing-clip="1"></span>
        </div>
      </div>

      <div class="pr__cta" data-pr-in>
        <!-- the same call to action as the "Start your next website today" section: big words and an arrow that swap places when pointed at -->
        <button class="next__cta pr__go" type="button" data-pricing-go data-cursor="Let's talk">
          <span class="pr__go-t">Start your website</span>
          <span class="next__word">today</span>
          <span class="next__arrow" aria-hidden="true"><svg viewBox="0 0 110 95"><path fill="currentColor" d={arrow}></path></svg></span>
        </button>
      </div>

      <!-- contact, as in the reference: how to reach me, the email, the other places to find me, and a live clock in my time zone -->
      <div class="pr__row pr__contact" data-pr-in>
        <span></span>
        <div class="pr__info">
          <p class="pr__text">The easiest way to reach me is directly. You can also find me across different social channels.</p>
          {
            site.email ? (
              <button class="pr__mail" type="button" data-copy={site.email}><span class="connect__mail-text">{site.email}</span> <span class="connect__mail-hint" data-copy-hint>Click to copy</span></button>
            ) : (
              <p class="pr__mail pr__mail--soon">Your email address goes here.</p>
            )
          }
          {site.socials.length > 0 && <ul class="pr__chan">{site.socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener me">{s.label}</a></li>)}</ul>}
        </div>
        <div class="pr__time">
          <svg class="pr__dial" viewBox="-100 -100 200 200" data-pricing-dial role="img" aria-label="Analogue clock showing my local time">
            <circle r="98" class="pr__dial-bg" />
            {ticks.map((i) => <line class="pr__tick" y1="-90" y2={i % 5 === 0 ? -78 : -84} transform={`rotate(${i * 6})`} />)}
            <line data-dial="h" class="pr__hand" y1="6" y2="-48" />
            <line data-dial="m" class="pr__hand" y1="8" y2="-72" />
            <line data-dial="s" class="pr__hand pr__hand--s" y1="14" y2="-78" />
          </svg>
          <p class="pr__tz">{site.timezone.replace('_', ' ').replace('/', ' / ')}<br /><span data-pricing-digital>--:--</span></p>
        </div>
      </div>
    </div>
  </div>
</div>
