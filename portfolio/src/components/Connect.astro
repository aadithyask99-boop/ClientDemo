---
import { site, projects } from '../data/site';
import Pixel from './Pixel.astro';
const year = new Date().getFullYear();
const sitemap = [
  ['Work', '#work'],
  ['Site Chemistry', '#chemistry'],
  ['Services', '#services'],
  ['About', '#about'],
];
---

<section class="connect" id="connect" data-world-section="dark" aria-labelledby="connect-title">
  <div class="connect__inner">
    <h2 id="connect-title" class="connect__title">Got a site in mind?</h2>
    <p class="connect__promise">I design your homepage first. You only pay once you love it. <button type="button" class="connect__pricing" data-pricing-open>See pricing</button></p>
    <!-- the contact form: one line at a time: Name, then it is replaced by Company, then Email, then Message with the send under it. There is no server behind the site, so
         sending opens the visitor's email app with the message already written (scripts/finale.ts). Without JavaScript every line simply shows. -->
    {
      site.email && (
        <form class="cform" data-contact-form data-to={site.email} novalidate>
          <div class="cform__step"><input class="cform__f" name="name" type="text" placeholder="Your name" aria-label="Your name" autocomplete="name" enterkeyhint="next" required /></div>
          <div class="cform__step"><input class="cform__f" name="company" type="text" placeholder="Company (optional)" aria-label="Company, optional" autocomplete="organization" enterkeyhint="next" /></div>
          <div class="cform__step"><input class="cform__f" name="email" type="email" placeholder="Your email" aria-label="Your email" autocomplete="email" enterkeyhint="next" required /></div>
          <div class="cform__step">
            <textarea class="cform__f" name="message" rows="1" placeholder="What are you after?" aria-label="Your message" required />
            <button class="cform__send" type="submit">Send message <svg viewBox="0 0 110 95" aria-hidden="true"><path fill="currentColor" d="M110 47.42 66.064 95 54.92 83.702l26.108-27.848H0V38.987h81.028L54.92 11.139 66.064 0z" /></svg></button>
          </div>
          <p class="cform__nav" data-form-nav hidden><button type="button" data-back>Back</button><button type="button" data-next>Next</button></p>
          <p class="cform__note" role="status" aria-live="polite" data-form-note></p>
        </form>
      )
    }

    <!-- the Work clips as a stack of rotated cards: press it and the top card is thrown to the back, round after round (scripts/finale.ts). The pictures and
         clips are borrowed from the Work section by the script, so nothing is downloaded twice. Without JavaScript they are plain tinted tiles. -->
    <div class="thumbs" data-thumbs role="button" tabindex="0" aria-label="Shuffle through the projects" data-cursor="Next">
      {
        projects.map((p) => (
          <div class="thumb" style={`--tint:${p.tint}`} />
        ))
      }
    </div>
  </div>

  <nav class="sitemap" aria-label="Sitemap and channels">
    <div class="sitemap__col">
      <p class="tag-b sitemap__h">Sitemap</p>
      <ul>
        {sitemap.map(([l, h]) => <li><a href={h}>{l}</a></li>)}
      </ul>
    </div>
    {
      site.socials.length > 0 && (
        <div class="sitemap__col">
          <p class="tag-b sitemap__h">Channels</p>
          <ul>
            {site.socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener me">{s.label}</a></li>)}
          </ul>
        </div>
      )
    }
  </nav>

  <footer class="connect__foot">
    <p>©{year} {site.owner}</p>
    <p class="connect__craft">Crafted by {site.short} <Pixel class="pixel--mini" /></p>
  </footer>
</section>
