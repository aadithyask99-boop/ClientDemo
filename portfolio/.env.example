# Portfolio environment
#
# Copy this file to `.env` and edit the values. `.env` is gitignored, so keys never get committed.
# Only this `.env.example` (no secrets) lives in git.
#
# Astro rule:
#   PUBLIC_*  -> shipped to the browser, so never put a secret in one of these.
#   everything else -> server / build only.
#
# Production: Cloudflare does not read `.env`. Set secrets with `wrangler secret put NAME`
# and public values as plain vars in wrangler config.

# ---------------------------------------------------------------
# Identity (public, safe to edit any time)
# ---------------------------------------------------------------

# Full URL of the deployed site, no trailing slash. Used for canonical links, sitemap and social cards.
PUBLIC_SITE_URL=http://localhost:4321

# Brand name is not decided yet, so this falls back to the owner's name.
PUBLIC_BRAND_NAME=Aadithya Sunil

PUBLIC_OWNER_NAME=Aadithya Sunil
# Short name used in the hero line: "Hi, I'm Aadi..."
PUBLIC_OWNER_SHORT_NAME=Aadi
PUBLIC_OWNER_ROLE=Digital Marketer & Web Designer

# IANA timezone for the live clock in the contact panel, e.g. Europe/London, Asia/Kolkata, America/New_York
PUBLIC_TIMEZONE=Europe/London
# Text shown beside the clock, e.g. "Hampshire, UK  ·  Remote worldwide"
PUBLIC_LOCATION_LABEL=

# Shown on the page and used for the click-to-copy button.
PUBLIC_CONTACT_EMAIL=

# Social links. Leave blank to hide a link.
PUBLIC_LINKEDIN_URL=
PUBLIC_INSTAGRAM_URL=
PUBLIC_X_URL=
PUBLIC_GITHUB_URL=

# ---------------------------------------------------------------
# Contact form (server only)
# ---------------------------------------------------------------
# Sends form submissions as email through Resend (https://resend.com).
RESEND_API_KEY=
# Where enquiries land.
CONTACT_TO_EMAIL=
# Must be an address on a domain verified in Resend.
CONTACT_FROM_EMAIL=

# ---------------------------------------------------------------
# Analytics and search (public tokens, not secrets)
# ---------------------------------------------------------------
# Cloudflare Web Analytics beacon token (cookieless).
PUBLIC_CF_ANALYTICS_TOKEN=
# Google Search Console "HTML tag" verification value (the content="..." part only).
PUBLIC_GOOGLE_SITE_VERIFICATION=

# ---------------------------------------------------------------
# Image generation at build time (server only, optional)
# ---------------------------------------------------------------
# Same approach the Orra demo uses: generate artwork through OpenRouter (https://openrouter.ai).
OPENROUTER_API_KEY=
# Model id from OpenRouter's image models. Seedream 5.0 Flash is the cheap default.
OPENROUTER_IMAGE_MODEL=bytedance-seed/seedream-5-0-flash
