---
import '@fontsource-variable/outfit';
import '@fontsource/instrument-serif';
import '../styles/global.css';
import '../styles/sections.css';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#7d8a91" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="preload" as="image" type="image/webp" href={`${base}/img/plate.webp`} />
    <link rel="preload" as="image" type="image/webp" href={`${base}/img/house.webp`} />
    <script is:inline>
      // The page is fully visible without JavaScript. The js class only switches the intro on.
      (function () {
        var d = document.documentElement;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        d.classList.add('js');
        // Big screens with a mouse get the full scroll-driven page (fx); phones and touch screens get the light one
        if (window.matchMedia('(min-width: 901px) and (hover: hover) and (pointer: fine)').matches) d.classList.add('fx');
        // If the script never started, never leave the page hidden
        window.setTimeout(function () {
          if (!window.__orra) { d.classList.remove('js'); d.classList.remove('fx'); }
        }, 6000);
      })();
    </script>
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
