---
import { people } from '../data/content';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const rail = [...people.photos, ...people.photos];
---

<section class="sec people" data-theme="dark">
  <div class="wrap people__lightstate">
    <p class="serif big" data-reveal>{people.statement}</p>
  </div>

  <!-- Phones and touch screens: a slow strip of photographs, the year, and the figures -->
  <div class="people__light">
    <div class="rail" aria-hidden="true">
      <div class="rail__track">
        {rail.map((p, i) => <img src={`${base}/img/p/${p}.webp`} alt="" width="560" height="700" loading="lazy" decoding="async" style={`--r: ${[-3, 2, -1.5, 3, -2.5, 1.5][i % 6]}deg; --y: ${[0, 2.2, 0.8, 3, 0.4, 2][i % 6]}rem`} />)}
      </div>
    </div>
    <div class="wrap">
      <p class="founded" data-reveal><strong>{people.founded}</strong> <span>Year of foundation</span></p>
      <ol class="figures" data-reveal>
        {people.stats.map((s) => (
          <li><strong><span data-count={s.n}>{s.n}</span>{s.plus ? '+' : ''}</strong><span class="serif">{s.label}</span></li>
        ))}
      </ol>
    </div>
  </div>

  <!-- Big screens: a ring of photographs turns round the founding year as you scroll, then the figures take over -->
  <div class="ring" data-ring>
    <p class="serif big ring__statement" data-ring-statement>{people.statement}</p>
    <div class="ring__group" data-ring-group aria-hidden="true">
      <div class="ring__photos" data-ring-photos>
        {[...people.photos, ...people.photos].map((p) => <img src={`${base}/img/p/${p}.webp`} alt="" width="560" height="700" loading="lazy" decoding="async" />)}
      </div>
      <div class="ring__core" data-ring-core>
        <p class="ring__year"><strong>{people.founded}</strong> <span>Year of<br />Foundation</span></p>
        <div class="ring__notes"><p>Design grounded in passive strategies, material logic and environmental responsibility.</p><p>Lifecycle-minded architecture with efficient systems, honest materials and long-term value.</p></div>
      </div>
    </div>
    <ol class="ring__stats" data-ring-stats aria-hidden="true">
      {people.stats.map((s) => (
        <li><strong>{s.n}{s.plus ? '+' : ''}</strong><span class="serif">{s.label}</span></li>
      ))}
    </ol>
  </div>
</section>
