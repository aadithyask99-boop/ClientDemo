---
import { partners } from '../data/content';
const a = partners.slice(0, 7);
const b = partners.slice(7);
---

<section class="sec partners" data-theme="light">
  <div class="wrap">
    <h2 class="display center" data-reveal>Studios, developers and hotels build with Orra</h2>
  </div>
  {[a, b].map((row, k) => (
    <div class={`marquee ${k ? 'marquee--rev' : ''}`} aria-hidden="true">
      <div class="marquee__track">
        {[...row, ...row, ...row, ...row].map((n) => <span class="logo-dot">{n}</span>)}
      </div>
    </div>
  ))}
  <p class="sr-only">{partners.join(', ')}</p>
</section>
