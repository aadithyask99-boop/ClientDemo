---
import { process } from '../data/content';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

{process.map((p, i) => (
  <section class="sec process" data-theme="light" data-process={i}>
    <div class="process__stage" data-pstage>
      <div class="wrap process__wrap">
        <h2 class="display center" data-mreveal data-ptitle>{p.title}</h2>
        <figure class="sketch" data-sketch data-psketch>
          <img src={`${base}/img/s/${p.img}.webp`} alt="" width="1500" height="1000" loading="lazy" decoding="async" />
        </figure>
        <div class={`process__text ${i % 2 ? 'process__text--left' : ''}`} data-mreveal data-ptext>
          <p class="serif lead">{p.lead}</p>
          <p>{p.text}</p>
        </div>
      </div>
    </div>
  </section>
))}
