---
import { process } from '../data/content';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

{process.map((p, i) => (
  <section class="sec process" data-theme="light">
    <div class="wrap">
      <h2 class="display center" data-reveal>{p.title}</h2>
      <figure class="sketch" data-sketch>
        <img src={`${base}/img/s/${p.img}.webp`} alt="" width="1500" height="1000" loading="lazy" decoding="async" />
      </figure>
      <div class={`process__text ${i % 2 ? 'process__text--left' : ''}`} data-reveal>
        <p class="serif lead">{p.lead}</p>
        <p>{p.text}</p>
      </div>
    </div>
  </section>
))}
