---
import { residences } from '../data/content';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="sec resid" id="residences" data-theme="light">
  <div class="wrap">
    <div class="resid__head" data-reveal>
      <h2 class="display">Selected<br />Residences <sup>8+</sup></h2>
      <a class="seeall" href="#contact">Enquire about a home</a>
    </div>
    <div class="grid">
      {residences.map((r, i) => (
        <article class={`tile tile--${r.shape} tile--${i + 1}`} data-tile>
          <a href="#contact" class="tile__link" aria-label={`${r.name}, ${r.area}`}>
            <div class="tile__frame">
              <img src={`${base}/img/r/${r.img}.webp`} alt="" width={r.shape === 'land' ? 1200 : 900} height={r.shape === 'land' ? 800 : 1125} loading="lazy" decoding="async" />
            </div>
            <div class="tile__cap"><span>{r.name}</span><span class="tile__area">{r.area}</span></div>
            <span class="tile__visit">Visit <i aria-hidden="true">↗</i></span>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
