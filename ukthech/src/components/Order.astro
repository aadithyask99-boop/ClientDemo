---
// Order arrives: the page's only pinned scene. A parcel arrives, opens, and the pack of paper lifts out and settles at the front.
// The scene is the real parcel photograph with a drawn open box on top of it: two hinged flaps with thickness and cast shadows,
// a dark interior with lit inner walls, and a pack of four warm paper sheets with a blue band and a blank tag.
// Everything is placed with a small 3D model (camera 25 degrees above, light from the left) so the shadows and shading follow the hinge.
// Final state is what you see with no JavaScript, on phones, and with reduced motion. The same maths lives in src/scripts/order.ts.
import { site } from '../data/site';
const o = site.order;
const ui = site.uiC;
const base = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');
const img = `${base}media/obj-parcel.webp`;

type P = [number, number];
type V = [number, number, number];
const f1 = (n: number) => +n.toFixed(1);
const pts = (...p: P[]) => p.map((q) => `${f1(q[0])},${f1(q[1])}`).join(' ');
const add = (p: P, q: P): P => [p[0] + q[0], p[1] + q[1]];
const mid = (p: P, q: P, t = 0.5): P => [p[0] + (q[0] - p[0]) * t, p[1] + (q[1] - p[1]) * t];

// ---- camera and light (identical to order.ts) ----
const RAD = Math.PI / 180, sE = Math.sin(16 * RAD), cE = Math.cos(16 * RAD);
const proj = (w: V): P => [w[0], -(w[1] * sE + w[2] * cE)];
const grd = (p: P): V => [p[0], -p[1] / sE, 0];
const crs = (a: V, b: V): V => [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]];
const dt = (a: V, b: V) => a[0] * b[0] + a[1] * b[1] + a[2] * b[2];
const unit = (a: V): V => { const l = Math.hypot(a[0], a[1], a[2]); return [a[0] / l, a[1] / l, a[2] / l]; };
const rotv = (v: V, a: V, r: number): V => { const c = Math.cos(r), s = Math.sin(r), x = crs(a, v), d = dt(a, v) * (1 - c); return [v[0] * c + x[0] * s + a[0] * d, v[1] * c + x[1] * s + a[1] * d, v[2] * c + x[2] * s + a[2] * d]; };
const CAM: V = [0, -cE, sE];
const SUN = unit([-0.9, 0.25, 1]);
const LX = 0.9, LY = -0.25, TH = 9;
const clamp = (x: number, a = 0, b = 1) => Math.max(a, Math.min(b, x));
const mstr = (m: number[]) => `matrix(${m.map((x) => +x.toFixed(4)).join(",")})`;
const mix3 = (a: number[], b: number[], t: number) => a.map((x, i) => x + (b[i] - x) * t);
const rgb = (c: number[]) => `rgb(${c.map((x) => Math.round(x)).join(',')})`;
const SHADED = [138, 101, 64], LIT = [201, 162, 115];
const EDGE_S = [150, 114, 72], EDGE_L = [238, 218, 176];

// Top face of the parcel in the 1376 x 768 photograph (A back-left, B back-right, C front-right, D front-left)
const A: P = [303, 233], B: P = [785, 145], C: P = [1072, 236], D: P = [556, 347];
const bil = (s: number, t: number): P => [(1 - t) * ((1 - s) * A[0] + s * B[0]) + t * ((1 - s) * D[0] + s * C[0]), (1 - t) * ((1 - s) * A[1] + s * B[1]) + t * ((1 - s) * D[1] + s * C[1])];
const MA = mid(A, D), MB = mid(B, C);
// each flap is a parallelogram whose side edges follow the right edge of the top face, so both of its far corners stay inside the photographed lid
const bF1 = mid(B, C, 0.47), fF1 = mid(C, B, 0.47);
const backPoly: P[] = [A, B, bF1, [A[0] + bF1[0] - B[0], A[1] + bF1[1] - B[1]]];
const frontPoly: P[] = [D, C, fF1, [D[0] + fF1[0] - C[0], D[1] + fF1[1] - C[1]]];

interface Flap { h0: P; h1: P; f0: P; f1: P; a: V; sg: number; w0: V; dl: P }
const mkFlap = (h0: P, h1: P, f0: P, f1: P): Flap => {
  // the side edge of a flap is perpendicular to its hinge in the world; dl corrects the photographed (perspective) edge back to that ideal
  const a = unit(grd([h1[0] - h0[0], h1[1] - h0[1]])), bw = grd([f0[0] - h0[0], f0[1] - h0[1]]);
  let pp: V = [-a[1], a[0], 0]; if (dt(pp, bw) < 0) pp = [-pp[0], -pp[1], 0];
  const L = Math.hypot(bw[0], bw[1]), w0: V = [pp[0] * L, pp[1] * L, 0], pw = proj(w0);
  return { h0, h1, f0, f1, a, w0, dl: [f0[0] - h0[0] - pw[0], f0[1] - h0[1] - pw[1]], sg: crs(a, w0)[2] < 0 ? -1 : 1 };
};
const back = mkFlap(A, B, backPoly[3], backPoly[2]);
const front = mkFlap(D, C, frontPoly[3], frontPoly[2]);

// pose of a flap at hinge angle th (degrees): matrices, tones and visibility of each part
function pose(F: Flap, th: number, outerBase: number[], innerBase: number[]) {
  const r = F.sg * th * RAD;
  const vr = rotv(F.w0, F.a, r), nr = rotv([0, 0, 1], F.a, r);
  const [ox, oy] = F.h0;
  const bx = F.h1[0] - ox, by = F.h1[1] - oy, vx = F.f0[0] - ox, vy = F.f0[1] - oy;
  const pv = proj(vr), cs = Math.cos(th * RAD), e2: P = [pv[0] + F.dl[0] * cs, pv[1] + F.dl[1] * cs], det = bx * vy - vx * by;
  const a = (bx * vy - e2[0] * by) / det, c = (-bx * vx + e2[0] * bx) / det, b = (by * vy - e2[1] * by) / det, d = (-by * vx + e2[1] * bx) / det;
  const e = ox - (a * ox + c * oy), f = oy - (b * ox + d * oy);
  const tv = proj([-nr[0] * TH, -nr[1] * TH, -nr[2] * TH]);
  const apply = (p: P): P => [a * p[0] + c * p[1] + e, b * p[0] + d * p[1] + f];
  const q0 = apply(F.f0), q1 = apply(F.f1);
  const visOut = dt(nr, CAM) > 0;
  const kOut = Math.max(0, dt(nr, SUN)), kIn = Math.max(0, -dt(nr, SUN));
  const tone = (k: number, baseC: number[]) => {
    const t = mix3(SHADED, LIT, clamp(0.3 + 0.85 * k));
    const lt = (t[0] + t[1] + t[2]) / 3, lb = (baseC[0] + baseC[1] + baseC[2]) / 3;
    return lt < lb ? { fill: 'rgb(34,20,9)', op: clamp(1 - lt / lb, 0, 0.9) } : { fill: 'rgb(255,234,196)', op: clamp((lt - lb) / (255 - lb), 0, 0.9) };
  };
  let ef = crs(nr, F.a); if (dt(ef, vr) < 0) ef = [-ef[0], -ef[1], -ef[2]];
  const edge = (k: number) => rgb(mix3(EDGE_S, EDGE_L, clamp(0.35 + 0.95 * k)));
  return {
    outer: [a, b, c, d, e, f], inner: [a, b, c, d, e + tv[0], f + tv[1]], visOut,
    shOut: tone(kOut, outerBase), shIn: tone(kIn, innerBase),
    free: { m: [q1[0] - q0[0], q1[1] - q0[1], tv[0], tv[1], q0[0], q0[1]], vis: dt(ef, CAM) > 0.02, fill: edge(Math.max(0, dt(ef, SUN))) },
    sl: { m: [q0[0] - ox, q0[1] - oy, tv[0], tv[1], ox, oy], vis: -dt(F.a, CAM) > 0.02, fill: edge(Math.max(0, -dt(F.a, SUN))) },
    sr: { m: [q1[0] - F.h1[0], q1[1] - F.h1[1], tv[0], tv[1], F.h1[0], F.h1[1]], vis: dt(F.a, CAM) > 0.02, fill: edge(Math.max(0, dt(F.a, SUN))) },
  };
}
// shadow of a hinged flap on the horizontal plane z = zp
function shadow(F: Flap, th: number, zp: number) {
  const r = F.sg * th * RAD, vr = rotv(F.w0, F.a, r), o = grd(F.h0);
  const q0 = proj([o[0] - LX * zp, o[1] - LY * zp, zp]);
  const e2 = proj([vr[0] + LX * vr[2], vr[1] + LY * vr[2], 0]);
  return [F.h1[0] - F.h0[0], F.h1[1] - F.h0[1], e2[0], e2[1], q0[0], q0[1]];
}
const OUT_BASE = [209, 172, 130], IN_BASE = [128, 86, 48];
const FINAL = { back: 135, front: 266 };
const pb = pose(back, FINAL.back, OUT_BASE, IN_BASE), pf = pose(front, FINAL.front, OUT_BASE, IN_BASE);
const HB = 316, ZI = -40; // box height and depth of the contents (world px)
const sdBackG = shadow(back, FINAL.back, -HB), sdFrontG = shadow(front, FINAL.front, -HB), sdBackI = shadow(back, FINAL.back, ZI);

// ---- opening, interior ----
const [a2, b2, c2, d2] = [bil(0.016, 0.034), bil(0.984, 0.034), bil(0.984, 0.966), bil(0.016, 0.966)];
const DC = 46; // visible depth of the inner back and right walls above the contents
const dn = (p: P, n: number): P => [p[0], p[1] + n];
const cavity = pts(a2, b2, c2, d2);
const wallBack = pts(a2, b2, dn(b2, 320), dn(a2, 320));
const wallRight = pts(b2, c2, dn(c2, 320), dn(b2, 320));
const contents = pts(dn(a2, DC), dn(b2, DC), dn(c2, DC), dn(d2, DC));
const leftShade = pts(a2, mid(a2, b2, 0.2), mid(d2, c2, 0.34), d2);
const inbox = `0,0 1376,0 1376,${f1(c2[1])} ${pts(c2, d2, a2)} 0,${f1(a2[1])}`;
const boxSil = pts([303, 233], [788, 144], [1071, 233], [1072, 508], [1061, 516], [556, 650], [307, 513]);
const frontWallPoly = pts([556, 347], [1072, 236], [1072, 508], [556, 650]);
const frontFlapCover = pts(D, C, [1072, 236 + 190], [556, 347 + 190]);

// ---- the pack of sheets lies in the table plane: U along the long edge of the parcel, V along the short edge ----
const U: P = [0.984, -0.18], V2: P = [0.912, 0.411];
const lenU = 330, lenV = 190, PC: P = [820, 648];
const O: P = [PC[0] - 0.5 * (lenU * U[0] + lenV * V2[0]), PC[1] - 0.5 * (lenU * U[1] + lenV * V2[1])];
const mtx = `matrix(${U[0]} ${U[1]} ${V2[0]} ${V2[1]} ${f1(O[0])} ${f1(O[1])})`;
const inPos: P = [(A[0] + B[0] + C[0] + D[0]) / 4, (A[1] + B[1] + C[1] + D[1]) / 4 + 30];
const T = 3.4; // thickness of one sheet in screen px
const detM = U[0] * V2[1] - V2[0] * U[1];
const du = (-V2[0] * T) / detM, dv = (U[0] * T) / detM; // a screen drop of T expressed in plane coordinates
const sheets = [0, 1, 2, 3].map((i) => ({ i, rise: -T * i, rot: [1.3, -1.9, 1.6, -1.0][i], ox: [0, 6, -5, 3][i], oy: [0, 1.5, -2, 1][i] }));
const u0 = lenU * 0.74, bw = 15;
const tag = { x: u0 - 96, y: 52, w: 64, h: 86 };
const geo = JSON.stringify({ A, B, C, D, PC, back: [A, B, backPoly[2], backPoly[3]], front: [D, C, frontPoly[2], frontPoly[3]], lenU, lenV, FINAL });
const frontEdgeP = (k: number) => `0,${lenV} ${lenU},${lenV} ${lenU + du},${lenV + dv} ${du},${lenV + dv}`;
const leftEdgeP = `0,0 0,${lenV} ${du},${lenV + dv} ${du},${dv}`;
// a soft shadow without a filter: stacked rounded rectangles of growing size, each faint (cheap to repaint every frame)
const soft = (x: number, y: number, w: number, h: number, blur: number, n = 6) => Array.from({ length: n }, (_, k) => { const g = blur * ((k + 0.5) / n - 0.5); return { x: f1(x - g), y: f1(y - g), width: f1(w + 2 * g), height: f1(h + 2 * g), rx: f1(Math.max(0, Math.abs(g))) }; });
// the same idea in unit space, for shadows drawn as a transformed unit square
const ush = (blur: number, n: number) => Array.from({ length: n }, (_, k) => { const g = blur * ((k + 0.5) / n - 0.5); return { x: +(-g).toFixed(4), y: +(-g).toFixed(4), width: +(1 + 2 * g).toFixed(4), height: +(1 + 2 * g).toFixed(4) }; });
const style = (m: number[]) => `transform:${mstr(m)}`;
const rotAbout = (deg: number, cx: number, cy: number) => { const r = deg * RAD, c = Math.cos(r), sn = Math.sin(r); return [c, sn, -sn, c, cx - (c * cx - sn * cy), cy - (sn * cx + c * cy)]; };
---
<section class="stage stage--dark order" data-order id="order" data-geo={geo} aria-labelledby="order-title">
  <div class="order-pin" data-o-pin>
    <h2 id="order-title" class="d56 order-title" data-o-title>{o.title}</h2>
    <div class="panel order-panel" data-o-panel>
      <div class="o-scene" data-o-scene role="img" aria-label={ui.orderAlt}>
        <div class="o-stage" data-o-stage aria-hidden="true">
          <div class="o-photo" data-o-photo>
            <img class="o-img" src={img} alt="" width="1376" height="768" decoding="async" />

            <!-- ground: contact shadow of the parcel and the shadows of the flaps (outside the parcel only) -->
            <svg class="o-svg" viewBox="0 0 1376 768" focusable="false">
              <defs>
                <filter id="o-b3" x="-30%" y="-30%" width="160%" height="160%"><feGaussianBlur stdDeviation="2.4" /></filter>
                <filter id="o-b5" x="-30%" y="-30%" width="160%" height="160%"><feGaussianBlur stdDeviation="4.5" /></filter>
                <filter id="o-b10" x="-30%" y="-30%" width="160%" height="160%"><feGaussianBlur stdDeviation="9" /></filter>
                <filter id="o-b16" x="-40%" y="-40%" width="180%" height="180%"><feGaussianBlur stdDeviation="16" /></filter>
                <filter id="o-b24" x="-30%" y="-30%" width="160%" height="160%"><feGaussianBlur stdDeviation="24" /></filter>
                <clipPath id="o-floor"><path clip-rule="evenodd" d={`M-300 -300H1700V1100H-300Z M${boxSil.replace(/ /g, ' L')}Z`}></path></clipPath>
                <pattern id="o-tex" patternUnits="userSpaceOnUse" width="280" height="200"><image href="data:image/jpeg;base64," width="280" height="200"></image></pattern>
                <linearGradient id="o-sd-flap" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="rgba(62,42,24,0.11)"></stop><stop offset="1" stop-color="rgba(62,42,24,0.02)"></stop></linearGradient>
                <linearGradient id="o-sd-flap-i" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="rgba(8,4,1,0.2)"></stop><stop offset="1" stop-color="rgba(8,4,1,0)"></stop></linearGradient>
                <clipPath id="o-wallclip"><polygon points={frontWallPoly}></polygon></clipPath>
              </defs>
              <g clip-path="url(#o-floor)">
                <g filter="url(#o-b24)"><polygon points="520,664 1070,528 1330,452 1296,586 930,716 560,700" fill="rgba(74,52,30,0.16)" data-o-ground></polygon></g>
                <g filter="url(#o-b5)"><polygon points="304,517 556,656 1064,520 1064,506 556,640 304,503" fill="rgba(60,40,22,0.34)" data-o-contact></polygon></g>
              </g>
            </svg>
            <svg class="o-svg" viewBox="0 0 1376 768" focusable="false">
              <g clip-path="url(#o-floor)">
                <g style={style(sdBackG)} data-fl-gsd="back">{ush(0.07, 5).map((r) => <rect {...r} fill="url(#o-sd-flap)"></rect>)}</g>
                <g style={style(sdFrontG)} data-fl-gsd="front">{ush(0.07, 5).map((r) => <rect {...r} fill="url(#o-sd-flap)"></rect>)}</g>
              </g>
            </svg>

            <!-- the opening: inner walls lit from the left, dark contents, soft shadows, a corrugated rim -->
            <svg class="o-svg" viewBox="0 0 1376 768" focusable="false">
              <defs>
                <clipPath id="o-clip-cav"><polygon points={cavity}></polygon></clipPath>
                                                <linearGradient id="o-g-wb" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="rgba(255,226,180,0.1)"></stop><stop offset="0.55" stop-color="rgba(40,22,8,0.18)"></stop><stop offset="0.85" stop-color="rgba(20,10,4,0.55)"></stop><stop offset="1" stop-color="rgba(14,7,3,0.7)"></stop></linearGradient>
                <linearGradient id="o-g-wr" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="rgba(244,196,128,0.6)"></stop><stop offset="0.6" stop-color="rgba(238,184,112,0.5)"></stop><stop offset="0.92" stop-color="rgba(120,72,30,0.3)"></stop><stop offset="1" stop-color="rgba(30,16,6,0.5)"></stop></linearGradient>
                <linearGradient id="o-g-ct" x1="0" y1="0" x2="1" y2="0.25"><stop offset="0" stop-color="rgba(50,40,30,0.72)"></stop><stop offset="1" stop-color="rgba(70,56,40,0.6)"></stop></linearGradient>
                <linearGradient id="o-g-ls" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="rgba(10,5,2,0.6)"></stop><stop offset="1" stop-color="rgba(10,5,2,0)"></stop></linearGradient>
                <linearGradient id="o-g-depth" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="rgba(10,5,2,0.4)"></stop><stop offset="0.35" stop-color="rgba(10,5,2,0)"></stop><stop offset="1" stop-color="rgba(10,5,2,0.1)"></stop></linearGradient>
                              </defs>
              <g clip-path="url(#o-clip-cav)">
                <g data-in="back"><polygon points={wallBack} fill="url(#o-tex)"></polygon><polygon points={wallBack} fill="url(#o-g-wb)"></polygon></g>
                <g data-in="right"><polygon points={wallRight} fill="url(#o-tex)"></polygon><polygon points={wallRight} fill="url(#o-g-wr)"></polygon></g>
                <g data-in="floor"><polygon points={contents} fill="url(#o-tex)"></polygon><polygon points={contents} fill="url(#o-g-ct)"></polygon></g>
                <polygon points={contents} fill="url(#o-g-depth)" data-in="depth"></polygon>
                <rect x={f1(a2[0] - 4)} y={f1(a2[1] - 20)} width="200" height="340" fill="url(#o-g-ls)" data-in="left"></rect>
                <g style={style(sdBackI)} data-fl-isd>{ush(0.06, 4).map((r) => <rect {...r} fill="url(#o-sd-flap-i)"></rect>)}</g>
                <g data-cav-shadow fill="rgba(12,6,2,0.12)"><g transform={`translate(${f1(inPos[0] - PC[0] + 12)} ${f1(inPos[1] - PC[1] + 9)}) ${mtx}`}>{soft(0, 0, lenU, lenV, 26, 8).map((r) => <rect {...r}></rect>)}</g></g>
              </g>
              <polygon points={cavity} fill="none" stroke="#dcc296" stroke-width="3.6" stroke-linejoin="round" opacity="0.85" data-in="rim"></polygon>
              <polygon points={cavity} fill="none" stroke="rgba(110,80,44,0.3)" stroke-width="3.6" stroke-dasharray="1.3 2.9" stroke-linejoin="round" data-in="rimflutes"></polygon>
            </svg>

            <!-- the back flap, rising behind the parcel -->
            <svg class="o-svg" viewBox="0 0 1376 768" focusable="false">
              <defs>
                <clipPath id="o-clip-back"><polygon points={pts(...backPoly)}></polygon></clipPath>
                <clipPath id="o-clip-front"><polygon points={pts(...frontPoly)}></polygon></clipPath>
                <linearGradient id="o-flute" x1="0" y1="0" x2="0.011" y2="0" spreadMethod="repeat"><stop offset="0" stop-color="rgba(86,58,28,0.0)"></stop><stop offset="0.5" stop-color="rgba(86,58,28,0.2)"></stop><stop offset="1" stop-color="rgba(86,58,28,0.0)"></stop></linearGradient>
                <linearGradient id="o-flute-s" x1="0" y1="0" x2="0.03" y2="0" spreadMethod="repeat"><stop offset="0" stop-color="rgba(86,58,28,0.0)"></stop><stop offset="0.5" stop-color="rgba(86,58,28,0.16)"></stop><stop offset="1" stop-color="rgba(86,58,28,0.0)"></stop></linearGradient>
              </defs>
              <g class="o-flap" data-flap="back">
                <g data-fp="sl" style={style(pb.sl.m)} display={pb.sl.vis ? 'inline' : 'none'}><rect width="1" height="1" fill={pb.sl.fill}></rect><rect width="1" height="1" fill="url(#o-flute-s)"></rect></g>
                <g data-fp="sr" style={style(pb.sr.m)} display={pb.sr.vis ? 'inline' : 'none'}><rect width="1" height="1" fill={pb.sr.fill}></rect><rect width="1" height="1" fill="url(#o-flute-s)"></rect></g>
                <g data-fp="ed" style={style(pb.free.m)} display={pb.free.vis ? 'inline' : 'none'}><rect width="1" height="1" fill={pb.free.fill}></rect><rect width="1" height="1" fill="url(#o-flute)"></rect></g>
                <g data-fp="in" style={style(pb.inner)} display={pb.visOut ? 'none' : 'inline'}><polygon points={pts(...backPoly)} fill="url(#o-tex)"></polygon><polygon points={pts(...backPoly)} fill={pb.shIn.fill} fill-opacity={f1(pb.shIn.op * 100) / 100} data-fp="ins"></polygon></g>
                <g data-fp="out" style={style(pb.outer)} display={pb.visOut ? 'inline' : 'none'}><g clip-path="url(#o-clip-back)"><image href={img} width="1376" height="768"></image></g><polygon points={pts(...backPoly)} fill={pb.shOut.fill} fill-opacity={f1(pb.shOut.op * 100) / 100} data-fp="outs"></polygon></g>
              </g>
            </svg>

            <!-- the pack of blank sheets -->
            <svg class="o-svg o-svg--pack" viewBox="0 0 1376 768" focusable="false" data-pk-svg>
              <defs>
                <clipPath id="o-inbox"><polygon points={inbox}></polygon></clipPath>
                <linearGradient id="o-paper" x1="0" y1="0" x2="1" y2="0.3"><stop offset="0" stop-color="#f6f3ec"></stop><stop offset="0.55" stop-color="#f1eee6"></stop><stop offset="1" stop-color="#dcd7cc"></stop></linearGradient>
                <linearGradient id="o-hl-l" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="rgba(255,255,255,0.95)"></stop><stop offset="1" stop-color="rgba(255,255,255,0)"></stop></linearGradient>
                <linearGradient id="o-hl-t" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="rgba(255,255,255,0.85)"></stop><stop offset="1" stop-color="rgba(255,255,255,0)"></stop></linearGradient>
                <linearGradient id="o-pkshade" x1="0" y1="0" x2="1" y2="0.2"><stop offset="0" stop-color="rgba(112,64,24,0.9)"></stop><stop offset="0.5" stop-color="rgba(112,64,24,0.6)"></stop><stop offset="1" stop-color="rgba(112,64,24,0.3)"></stop></linearGradient>
                <linearGradient id="o-curl" x1="0" y1="0" x2="1" y2="1"><stop offset="0.6" stop-color="rgba(120,108,88,0)"></stop><stop offset="1" stop-color="rgba(120,108,88,0.2)"></stop></linearGradient>
                <linearGradient id="o-band" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#5a74ff"></stop><stop offset="0.35" stop-color="#4663ff"></stop><stop offset="1" stop-color="#3550e0"></stop></linearGradient>
                <linearGradient id="o-bandwrap" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#3a55ea"></stop><stop offset="1" stop-color="#2a3fb4"></stop></linearGradient>
              </defs>
              <g class="o-pk-shadow">
                <g data-pk-sd="far" fill="rgba(70,50,30,0.075)"><g transform={mtx}>{soft(34, 26, lenU, lenV, 40, 8).map((r) => <rect {...r}></rect>)}</g></g>
                <g data-pk-sd="near" fill="rgba(52,36,20,0.14)"><g transform={mtx}>{soft(10, 9, lenU, lenV, 10, 5).map((r) => <rect {...r}></rect>)}</g></g>
              </g>
              <g data-pk-clip>
                <g class="o-pack" data-pack>
                  {sheets.map((s) => (
                    <g class="o-sheet" data-o-sheet={s.i}>
                      <g transform={`translate(${s.ox} ${s.rise + s.oy})`}>
                        <g transform={mtx}>
                          <g data-sh-rot={s.i} data-r0={s.rot} style={style(rotAbout(s.rot, lenU / 2, lenV / 2))}>
                            <g data-sh-sd={s.i} fill={s.i === 0 ? 'rgba(52,36,20,0.12)' : 'rgba(80,66,46,0.15)'}>{soft(5, 6, lenU, lenV, 5, 4).map((r) => <rect {...r}></rect>)}</g>
                            <polygon points={leftEdgeP} fill={s.i % 2 ? '#e4dfd4' : '#d3cec2'}></polygon>
                            <polygon points={frontEdgeP(0)} fill={s.i % 2 ? '#d9d4c8' : '#ece8de'}></polygon>
                            <rect width={lenU} height={lenV} rx="1.5" fill="url(#o-paper)"></rect>
                            <rect width={lenU} height={lenV} rx="1.5" fill="url(#o-curl)" data-sh-shade={s.i} opacity={0.5 + s.i * 0.1}></rect>
                            <rect x="0" y="0" width="3" height={lenV} fill="url(#o-hl-l)"></rect>
                            <rect x="0" y="0" width={lenU} height="2.4" fill="url(#o-hl-t)"></rect>
                          </g>
                        </g>
                      </g>
                    </g>
                  ))}
                  <g transform={`translate(0 ${-T * 3})`}>
                    <g transform={mtx} opacity="1"><rect width={lenU} height={lenV} fill="url(#o-pkshade)" data-pk-shade opacity="0" rx="1.5"></rect></g>
                  </g>
                  <g class="o-band" data-band>
                    <g transform={`translate(0 ${-T * 3 - 0.8})`}>
                      <g data-band-sd fill="rgba(30,34,70,0.11)"><g transform={mtx}>{soft(u0 + 4, 2, bw + 5, lenV + 3, 6, 3).map((r) => <rect {...r}></rect>)}</g></g>
                      <g transform={mtx}>
                        <rect x={u0} y="-0.5" width={bw} height={lenV + 1} fill="url(#o-band)"></rect>
                        <rect x={u0 + 1.5} y="-0.5" width="2.4" height={lenV + 1} fill="rgba(190,205,255,0.55)"></rect>
                        <polygon points={`${u0},${lenV + 0.5} ${u0 + bw},${lenV + 0.5} ${u0 + bw + du * 4},${lenV + 0.5 + dv * 4} ${u0 + du * 4},${lenV + 0.5 + dv * 4}`} fill="url(#o-bandwrap)" data-band-wrap></polygon>
                      </g>
                    </g>
                  </g>
                  <g class="o-tag" data-tag>
                    <g transform={`translate(0 ${-T * 3 - 1.4})`}>
                      <g transform={mtx}>
                        <g data-tag-str><path d={`M ${u0 + 4} ${lenV * 0.32} C ${u0 - 18} ${lenV * 0.2} ${tag.x + 70} ${tag.y - 4} ${tag.x + tag.w / 2 + 2} ${tag.y + 12}`} fill="none" stroke="#6f6a5e" stroke-width="1.8" stroke-linecap="round"></path></g>
                        <g data-tag-sd fill="rgba(60,44,26,0.12)" transform={`rotate(-8 ${tag.x + tag.w / 2} ${tag.y + tag.h / 2})`}>{soft(tag.x + 4, tag.y + 5, tag.w, tag.h, 6, 3).map((r) => <rect {...r}></rect>)}</g>
                        <g data-tag-body transform={`rotate(-8 ${tag.x + tag.w / 2} ${tag.y + tag.h / 2})`}>
                          <rect x={tag.x} y={tag.y} width={tag.w} height={tag.h} rx="6" fill="#f3efe5"></rect>
                          <rect x={tag.x} y={tag.y} width="2.6" height={tag.h} rx="1.3" fill="url(#o-hl-l)"></rect>
                          <circle cx={tag.x + tag.w / 2} cy={tag.y + 11} r="4.2" fill="#b9b3a4"></circle>
                          <circle cx={tag.x + tag.w / 2 - 0.5} cy={tag.y + 10.6} r="2.8" fill="#8a8579"></circle>
                        </g>
                      </g>
                    </g>
                  </g>
                </g>
              </g>
            </svg>

            <!-- the front flap folds down in front of the parcel -->
            <svg class="o-svg o-svg--front" viewBox="0 0 1376 768" focusable="false">
              <defs>
                <filter id="o-b6" x="-30%" y="-30%" width="160%" height="160%"><feGaussianBlur stdDeviation="5" /></filter>
                <linearGradient id="o-wallshade" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="rgba(12,6,2,0.55)"></stop><stop offset="1" stop-color="rgba(12,6,2,0.0)"></stop></linearGradient>
              </defs>
              <g clip-path="url(#o-wallclip)"><g data-fl-wsd style={style([pf.outer[0], pf.outer[1], pf.outer[2], pf.outer[3], pf.outer[4] + 10, pf.outer[5] + 12])}>{[14, 9, 4, 0].map((w) => <polygon points={pts(...frontPoly)} fill="rgba(12,6,2,0.1)" stroke="rgba(12,6,2,0.1)" stroke-width={w} stroke-linejoin="round"></polygon>)}</g></g>
              <g class="o-flap" data-flap="front">
                <g data-fp="sl" style={style(pf.sl.m)} display={pf.sl.vis ? 'inline' : 'none'}><rect width="1" height="1" fill={pf.sl.fill}></rect><rect width="1" height="1" fill="url(#o-flute-s)"></rect></g>
                <g data-fp="sr" style={style(pf.sr.m)} display={pf.sr.vis ? 'inline' : 'none'}><rect width="1" height="1" fill={pf.sr.fill}></rect><rect width="1" height="1" fill="url(#o-flute-s)"></rect></g>
                <g data-fp="ed" style={style(pf.free.m)} display={pf.free.vis ? 'inline' : 'none'}><rect width="1" height="1" fill={pf.free.fill}></rect><rect width="1" height="1" fill="url(#o-flute)"></rect></g>
                <g data-fp="in" style={style(pf.inner)} display={pf.visOut ? 'none' : 'inline'}><polygon points={pts(...frontPoly)} fill="url(#o-tex)"></polygon><polygon points={pts(...frontPoly)} fill={pf.shIn.fill} fill-opacity={f1(pf.shIn.op * 100) / 100} data-fp="ins"></polygon></g>
                <g data-fp="out" style={style(pf.outer)} display={pf.visOut ? 'inline' : 'none'}><g clip-path="url(#o-clip-front)"><image href={img} width="1376" height="768"></image></g><polygon points={pts(...frontPoly)} fill={pf.shOut.fill} fill-opacity={f1(pf.shOut.op * 100) / 100} data-fp="outs"></polygon></g>
              </g>
            </svg>
          </div>
        </div>
        <div class="o-lights" aria-hidden="true"><i data-o-light></i></div>
      </div>
      <div class="o-side">
        <ol class="o-steps">
          {o.steps.map((s) => (
            <li class="o-step" data-step>
              <h3 data-s-title>{s.title}</h3>
              <p class="o-line" data-s-line>{s.line}</p>
            </li>
          ))}
        </ol>
        <p class="o-note" data-o-note>{o.note}</p>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .order { overflow: clip; }
  .order-pin { position: relative; min-height: 100svh; display: flex; flex-direction: column; gap: clamp(14px, 2.2vh, 24px); padding: 110px var(--gutter) clamp(16px, 2.4vh, 26px); }
  .order-title { color: var(--p); font-weight: 400; max-width: 40ch; }
  .order-panel { flex: 1; min-height: 0; display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 0; }
  .o-scene { position: relative; overflow: hidden; container-type: size; background: #e9e1d2; border-radius: calc(var(--r) - 8px); margin: 8px; min-height: 360px; isolation: isolate; }
  .o-lights { position: absolute; inset: 0; pointer-events: none; z-index: 5; }
  .o-lights i { position: absolute; inset: 0; background: rgba(40, 28, 16, 0.26); opacity: 0; }
  .o-stage { position: absolute; left: 50%; top: 50%; width: max(150cqw, 180cqh); aspect-ratio: 1376 / 768; transform: translate(-50%, -50%); }
  .o-photo { position: absolute; inset: 0; will-change: transform; transform-origin: 48% 60%; }
  .o-svg, .o-img { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .o-svg--pack { z-index: 4; }
  .o-svg--front { z-index: 3; }
  .o-side { display: flex; flex-direction: column; justify-content: center; gap: clamp(22px, 4vh, 44px); padding: clamp(24px, 3vw, 56px) clamp(24px, 3.4vw, 64px) clamp(24px, 3vh, 36px) clamp(20px, 2.6vw, 44px); min-width: 0; }
  .o-steps { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: clamp(26px, 5.4vh, 58px); }
  .o-step h3 { font-size: var(--f48); line-height: 1.04; letter-spacing: -0.03em; font-weight: 400; color: var(--ink); margin-bottom: 0.28em; }
  .o-line { font-size: var(--f20); line-height: 1.38; color: var(--ink); max-width: 24em; }
  .o-note { font-size: var(--f16); line-height: 1.45; color: rgba(22, 24, 27, 0.7); max-width: 30em; }

  @media (max-width: 899px) {
    .order-pin { min-height: 0; padding-top: 96px; padding-bottom: 48px; gap: 22px; }
    .order-panel { grid-template-columns: 1fr; }
    .o-scene { min-height: 0; aspect-ratio: 1 / 0.86; }
    .o-stage { width: max(138cqw, 180cqh); }
    .o-side { padding: 20px 22px 30px; gap: 26px; }
    .o-step h3 { font-size: var(--f35); }
  }
</style>
