---
// What schools buy first: one white panel on graphite. The Chromebooks tile is the big one; trolleys and tablets sit beside it.
// Hover (or focus, or a tap on touch) swaps the still for its close-up, as on the PrimeAsia cards.
import { site } from '../data/site';

const base = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');
const media = (n: string) => `${base}media/${n}.webp`;
const s = site.schools;
const tiles = [
  { key: 'lead', area: 'lead', item: s.lead, ground: '#dad3c6', egg: 'chromebook' },
  { key: 'a', area: 'a', item: s.sideA, ground: '#e0dace', egg: '' },
  { key: 'b', area: 'b', item: s.sideB, ground: '#e6e0d1', egg: '' },
];
---
<section class="stage stage--dark sc" data-schools aria-labelledby="sc-title">
  <div class="panel sc-panel">
    <h2 class="sc-title d56" id="sc-title">{s.title}</h2>
    {tiles.map((t) => (
      <article
        class={`sc-tile sc-tile--${t.key}`}
        style={`--ground:${t.ground}`}
        data-tile
        data-egg={t.egg || undefined}
        tabindex="0"
        aria-label={`${t.item.name}. ${t.item.line}`}
      >
        <div class="sc-pic">
          <div class="sc-par" data-par>
            <img class="sc-img" src={media(t.item.image)} alt="" loading="lazy" decoding="async" />
            <img class="sc-alt" src={media(t.item.closeup)} alt="" loading="lazy" decoding="async" />
          </div>
        </div>
        <div class="sc-scrim"></div>
        <div class="sc-text" data-text>
          <h3 class="sc-name">{t.item.name}</h3>
          <p class="sc-line">{t.item.line}</p>
        </div>
      </article>
    ))}
    <a class="btn sc-cta" href="#quote" data-open-quote>{site.hero.cta}</a>
  </div>
</section>

<style is:global>
  .sc { padding: var(--frame); }
  .sc-panel {
    position: relative; display: grid; gap: 12px; padding: 12px;
    grid-template-columns: 2fr 3fr; grid-template-rows: auto 3fr 2fr;
    grid-template-areas: "title lead" "a lead" "b lead";
    height: clamp(720px, calc(100svh - var(--frame) * 2), 940px);
  }
  .sc-title { grid-area: title; padding: 84px 18px 14px; max-width: 9em; font-weight: 400; }
  .sc-tile--lead { grid-area: lead; --nm: var(--f56); }
  .sc-tile--a { grid-area: a; --nm: var(--f35); }
  .sc-tile--b { grid-area: b; --nm: var(--f35); }

  .sc-tile {
    position: relative; overflow: hidden; border-radius: 18px; background: var(--ground, #ece6da);
    color: var(--ink); outline-offset: -3px; isolation: isolate; min-height: 0; cursor: default;
  }
  .sc-pic, .sc-par { position: absolute; inset: 0; }
  .sc-img, .sc-alt { position: absolute; display: block; max-width: none; object-fit: cover; }

  /* Lead: the still sits on the upper part and melts into the tile ground, so the name sits on clean ground */
  .sc-tile--lead .sc-img {
    left: 0; top: 0; width: 100%; height: 80%; object-position: 50% 60%;
    -webkit-mask-image: linear-gradient(to bottom, #000 74%, transparent);
    mask-image: linear-gradient(to bottom, #000 74%, transparent);
  }
  /* Trolleys: same pattern as the lead, the name sits on clean ground below the still */
  .sc-tile--a .sc-img {
    left: 0; top: 0; width: 100%; height: 72%; object-position: 50% 75%;
    -webkit-mask-image: linear-gradient(to bottom, #000 84%, transparent);
    mask-image: linear-gradient(to bottom, #000 84%, transparent);
  }
  /* Tablets: the still sits right, the name sits left */
  .sc-tile--b .sc-img {
    right: 0; top: 0; width: 60%; height: 100%; object-position: 50% 55%;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 30%);
    mask-image: linear-gradient(to right, transparent, #000 30%);
  }
  .sc-alt { inset: 0; width: 100%; height: 100%; opacity: 0; transform: scale(1.08); }
  .sc-img { transition: opacity 0.45s var(--ease), transform 0.45s var(--ease); }
  .sc-alt { transition: opacity 0.45s var(--ease), transform 0.6s var(--ease); }
  .sc-scrim { position: absolute; inset: 0; background: rgba(22,24,27,0.38); opacity: 0; transition: opacity 0.45s var(--ease); z-index: 1; pointer-events: none; }

  .sc-text { position: absolute; left: 28px; right: 28px; bottom: 24px; z-index: 2; }
  .sc-name { font-size: var(--nm); line-height: 1.02; letter-spacing: -0.03em; font-weight: 400; transition: color 0.45s var(--ease); }
  .sc-line { margin-top: 10px; font-size: var(--f20); line-height: 1.3; max-width: 22em; color: rgba(22,24,27,0.72); transition: color 0.45s var(--ease); }
  .sc-tile--lead .sc-text { right: 34%; bottom: 30px; left: 34px; }
  .sc-tile--lead .sc-line { max-width: 18em; }
  .sc-tile--a .sc-text { right: 28px; }
  .sc-tile--b .sc-text { right: 42%; }
  .sc-tile--b .sc-line { max-width: 12em; }

  .sc-tile:focus-visible { outline: 3px solid var(--b); }
  .sc-tile:focus-visible .sc-img, .sc-tile.is-on .sc-img { opacity: 0; transform: scale(1.04); }
  .sc-tile:focus-visible .sc-alt, .sc-tile.is-on .sc-alt { opacity: 1; transform: scale(1); }
  .sc-tile:focus-visible .sc-scrim, .sc-tile.is-on .sc-scrim { opacity: 1; }
  .sc-tile:focus-visible .sc-name, .sc-tile.is-on .sc-name { color: var(--w); }
  .sc-tile:focus-visible .sc-line, .sc-tile.is-on .sc-line { color: rgba(255,255,255,0.88); }
  @media (hover: hover) {
    .sc-tile { cursor: pointer; }
    .sc-tile:hover .sc-img { opacity: 0; transform: scale(1.04); }
    .sc-tile:hover .sc-alt { opacity: 1; transform: scale(1); }
    .sc-tile:hover .sc-scrim { opacity: 1; }
    .sc-tile:hover .sc-name { color: var(--w); }
    .sc-tile:hover .sc-line { color: rgba(255,255,255,0.88); }
  }

  .sc-cta { position: absolute; right: 34px; bottom: 34px; z-index: 5; }

  @media (max-width: 899px) {
    .sc-panel { display: flex; flex-direction: column; height: auto; gap: 10px; padding: 10px; }
    .sc-title { padding: 18px 12px 10px; max-width: none; }
    .sc-tile { flex: none; }
    .sc-tile--lead { aspect-ratio: 4 / 5; }
    .sc-tile--a, .sc-tile--b { aspect-ratio: 4 / 3.2; }
    .sc-tile--lead .sc-img, .sc-tile--a .sc-img, .sc-tile--b .sc-img {
      left: 0; right: 0; top: 0; width: 100%; height: 70%; object-position: 50% 60%;
      -webkit-mask-image: linear-gradient(to bottom, #000 72%, transparent);
      mask-image: linear-gradient(to bottom, #000 72%, transparent);
    }
    .sc-text, .sc-tile--lead .sc-text, .sc-tile--a .sc-text, .sc-tile--b .sc-text { left: 20px; right: 20px; bottom: 18px; }
    .sc-line { font-size: var(--f16); }
    .sc-cta { position: static; align-self: stretch; margin-top: 4px; padding-block: 1.05em; }
  }
</style>
