---
// Hero: an inset film of four places that crossfade, "Tech for" + the scene word dimmed, four thumbnails with a progress bar,
// a large Get a quote button. The scene answers the cursor (see hero.ts). Scene one is fully visible without JS.
import { site } from '../data/site';
const base = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');
const m = (n: string) => `${base}media/${n}.webp`;
const { lead, scenes, interval, cta } = site.hero;
// Where each place sits in a portrait crop (the subject of each frame)
const focus: Record<string, string> = { 'hero-school': '68% 50%', 'hero-ward': '62% 50%', 'hero-council': '42% 50%', 'hero-hotel': '55% 50%' };
---
<section data-hero class="hero" id="top" style={`--iv:${interval}ms`} aria-label="Introduction">
  <div class="hero-film">
    <div class="hero-scenes" data-scenes>
      <div class="hero-layer" data-layer>
        {scenes.map((s, i) => (
          <div class={`hero-scene${i === 0 ? ' is-active' : ''}`} data-scene>
            <img src={m(s.image)} alt={s.alt} style={`object-position:${focus[s.image] ?? '50% 50%'}`} width="1376" height="768" fetchpriority={i === 0 ? 'high' : 'low'} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
          </div>
        ))}
      </div>
    </div>
    <div class="hero-glow" data-glow aria-hidden="true"></div>
    <div class="hero-scrim" aria-hidden="true"></div>

    <div class="hero-copy">
      <h1 class="display hero-title hero-in" data-title>
        <span class="hero-lead">{lead}</span>
        <span class="hero-words dim" data-words>
          {scenes.map((s, i) => <span class={`hero-word${i === 0 ? ' is-active' : ''}`} aria-hidden={i === 0 ? 'false' : 'true'}>{s.word}</span>)}
        </span>
      </h1>
      <div class="hero-thumbs hero-in" role="group" aria-label="Choose a place">
        {scenes.map((s, i) => (
          <button type="button" class={`hero-thumb${i === 0 ? ' is-active' : ''}`} data-thumb aria-label={`Show ${s.word}`} aria-pressed={i === 0 ? 'true' : 'false'}>
            <img src={m(`${s.image}-thumb`)} alt="" width="360" height="201" loading="eager" decoding="async" />
            <span class="hero-bar"></span>
          </button>
        ))}
      </div>
    </div>
    <a class="btn hero-cta hero-in" href="#quote" data-open-quote>{cta}</a>
  </div>
</section>

<style is:global>
  .hero { position: relative; height: 100svh; min-height: 560px; padding: var(--frame); background: var(--g); }
  .hero-film { position: relative; height: 100%; border-radius: var(--r); overflow: hidden; background: #0d0e10; isolation: isolate; }

  .hero-scenes { position: absolute; inset: 0; will-change: transform; }
  .hero-layer { position: absolute; inset: 0; transform: scale(1.02); will-change: transform; }
  .hero-scene { position: absolute; inset: 0; opacity: 0; transition: opacity 1.1s var(--ease); }
  .hero-scene.is-active { opacity: 1; }
  .hero-scene img { width: 100%; height: 100%; max-width: none; object-fit: cover; transform: scale(1); transition: transform 0s linear 1.2s; }
  .hero-scene.is-active img { transform: scale(1.04); transition: transform 8s linear 0s; }

  /* Real light: a warm glow that follows the cursor (fine pointers only) */
  .hero-glow {
    position: absolute; left: 0; top: 0; width: 560px; height: 560px; margin: -280px 0 0 -280px; border-radius: 50%; pointer-events: none; z-index: 1;
    background: radial-gradient(closest-side, rgba(255, 214, 160, 0.42), rgba(255, 214, 160, 0.14) 55%, rgba(255, 214, 160, 0) 100%);
    opacity: 0; transition: opacity 0.6s var(--ease); will-change: transform;
  }
  .hero-glow.is-on { opacity: 0.75; }
  /* A soft dark scrim for the headline: strongest bottom left, gone by the middle */
  .hero-scrim { position: absolute; inset: 0; pointer-events: none; z-index: 2; background: radial-gradient(110% 85% at 0% 100%, rgba(14, 15, 17, 0.82) 0%, rgba(14, 15, 17, 0.52) 36%, rgba(14, 15, 17, 0) 68%); }

  .hero-copy { position: absolute; left: clamp(20px, 2.4vw, 34px); bottom: clamp(20px, 2.2vw, 32px); z-index: 3; display: grid; gap: clamp(24px, 3vw, 44px); justify-items: start; }
  .hero-title { color: var(--w); text-shadow: 0 2px 28px rgba(10, 11, 13, 0.4); }
  .hero-lead { display: block; }
  .hero-words { display: grid; }
  .hero-word { grid-area: 1 / 1; opacity: 0; transform: translateY(0.18em); transition: opacity 0.6s var(--ease), transform 0.6s var(--ease); }
  .hero-word.is-active { opacity: 1; transform: none; }

  .hero-thumbs { display: flex; gap: 8px; }
  .hero-thumb { position: relative; width: 96px; height: 64px; border-radius: 8px; overflow: hidden; padding: 0; background: #1a1c1f; outline: 2px solid transparent; outline-offset: -2px; transition: outline-color var(--t) var(--ease), transform var(--t) var(--ease), opacity var(--t) var(--ease); opacity: 0.78; }
  .hero-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .hero-thumb:hover { opacity: 1; transform: translateY(-2px); }
  .hero-thumb.is-active { opacity: 1; outline-color: rgba(255, 255, 255, 0.92); }
  .hero-thumb:focus-visible { outline: 3px solid var(--bt); outline-offset: 2px; }
  .hero-bar { position: absolute; left: 6px; right: 6px; bottom: 6px; height: 3px; border-radius: 3px; background: rgba(255, 255, 255, 0.28); transform: scaleX(0); transform-origin: 0 50%; opacity: 0; }
  .hero-bar::after { content: ''; position: absolute; inset: 0; border-radius: 3px; background: #fff; transform-origin: 0 50%; transform: scaleX(0); }
  .hero-thumb.is-active .hero-bar { opacity: 1; transform: none; }
  .hero-thumb.is-active .hero-bar::after { animation: hero-fill var(--iv, 5300ms) linear forwards; }
  .hero.is-paused .hero-thumb.is-active .hero-bar::after, .js .hero:not(.is-ready) .hero-thumb.is-active .hero-bar::after { animation-play-state: paused; }
  .hero:not(.is-ready) .hero-scene.is-active img { transform: scale(1); transition: none; }
  .hero.is-static .hero-thumb.is-active .hero-bar::after { animation: none; transform: scaleX(1); }
  @keyframes hero-fill { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  /* Without JS the bar would never advance; show it full */
  html:not(.js) .hero-bar::after { transform: scaleX(1); }

  .hero-cta { position: absolute; right: clamp(20px, 2.4vw, 34px); bottom: clamp(20px, 2.2vw, 32px); z-index: 3; font-size: clamp(20px, 1.9vw, 26px); padding: 0.95em 2em; }

  /* The intro: pieces rise in after the loader. Without JS, or if the script fails, they show after 3.5 s at the latest. */
  .js .hero:not(.is-ready) .hero-in { opacity: 0; animation: hero-show 0.01s 3.5s forwards; }
  @keyframes hero-show { to { opacity: 1; } }

  @media (max-width: 899px) {
    .hero { min-height: 520px; }
    .hero-thumb { width: 72px; height: 50px; }
    .hero-thumbs { gap: 6px; }
    .hero-cta { display: none; }
    .hero-scene.is-active img { transition-duration: 8s; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-scene.is-active img { transform: none; }
    .hero-bar::after { animation: none !important; transform: scaleX(1); }
  }
</style>
