---
import Base from '../layouts/Base.astro';
import Loader from '../components/Loader.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Statement from '../components/Statement.astro';
import Schools from '../components/Schools.astro';
import Quote from '../components/Quote.astro';
import Order from '../components/Order.astro';
import Promise from '../components/Promise.astro';
import Footer from '../components/Footer.astro';
import QuoteSheet from '../components/QuoteSheet.astro';
---
<Base title="UK Thech homepage (concept)" description="A concept homepage for a UK B2B technology supplier to schools, health, councils and hospitality.">
  <Loader />
  <Nav />
  <main>
    <Hero />
    <Statement />
    <Schools />
    <Quote />
    <Order />
    <Promise />
  </main>
  <Footer />
  <QuoteSheet />
</Base>
