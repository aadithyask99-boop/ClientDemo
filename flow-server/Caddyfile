# Automatic HTTPS for <ip>.sslip.io. /mcp/<secret> is the MCP endpoint, /browser/ is the sign-in window (password-protected).
{$SITE_HOST} {
	handle /health {
		reverse_proxy 127.0.0.1:8787
	}
	handle /mcp/* {
		reverse_proxy 127.0.0.1:8787 {
			flush_interval -1
			transport http {
				response_header_timeout 300s
			}
		}
	}
	handle /browser/* {
		reverse_proxy 127.0.0.1:3000
	}
	handle {
		respond "Not found" 404
	}
}
