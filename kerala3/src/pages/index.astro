---
import '@fontsource-variable/newsreader';
import '@fontsource-variable/albert-sans';
import '@fontsource-variable/inter-tight';
import '@fontsource-variable/noto-sans-malayalam';
import '@fontsource/instrument-serif';
import { existsSync } from 'node:fs';
import '../styles/global.css';
import { site } from '../data/site';
import credits from '../../credits.json';
const base = import.meta.env.BASE_URL;
const img = (n: string) => `${base}img/${n}.webp`;
const leaf = (n: string) => `${base}img/leaf/${n}.webp`;
const alt = (n: string) => (credits as any[]).find((c) => c.name === n)?.alt ?? '';
const monthsFlat = site.seasons.flatMap((s) => s.months);
const ordered = ['January','February','March','April','May','June','July','August','September','October','November','December'];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.title}</title>
    <meta name="description" content={site.description} />
    <meta name="theme-color" content="#f4f3ef" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <script is:inline>
      (function(){var d=document.documentElement;
      if(innerWidth>820&&!matchMedia("(prefers-reduced-motion: reduce)").matches)d.classList.add("pin");
      var m=(location.hash.match(/hero=([1234])/)||[])[1]||"4";d.dataset.hero=m;if(m==="4"&&innerWidth>820&&!matchMedia("(prefers-reduced-motion: reduce)").matches){d.classList.add("intro");setTimeout(function(){d.classList.remove("intro")},7000)}})();/*k3intro*/
    </script>
    <link rel="preload" as="image" href={img('hero-monsoon')} />
  </head>
  <body>
    <header class="top" id="top" data-on="dark">
      <nav class="top-nav" aria-label="Main">
        {site.nav.map((n, i) => <a href={n.href} class={i === 0 ? 'has-mega' : ''}>{n.label}</a>)}
      </nav>
      <a class="brand" href={base} aria-label="Kerala Tourism, home">KERALAM</a>
      <div class="top-right">
        <a class="pill" href={site.officialUrl}>Plan your trip</a>
      </div>
      <div class="mega" id="mega" aria-hidden="true">
        {site.mega.map((c) => (
          <div class="mega-col"><h3>{c.title}</h3>{c.links.map((l) => <a href="#places">{l}</a>)}</div>
        ))}
      </div>
    </header>

    <main>
      <!-- 1 HERO: three options, chosen with the review switch (#hero=1|2|3) -->
      <section class="hero" id="hero" data-tone="dark">
        <div class="stage s1" aria-hidden="false">
          {site.hero.seasons.map((s, i) => (
            <img class={`season ${i === 0 ? 'on' : ''}`} src={img(s.img)} alt={i === 0 ? alt(s.img) : ''} data-weather={s.weather} fetchpriority={i === 0 ? 'high' : 'low'} />
          ))}
          <canvas class="weather" id="weather" aria-hidden="true"></canvas>
          <div class="fol fol1" aria-hidden="true">
            <img class="f" data-depth="0.5" src={leaf('leaf-palm-top')} alt="" style="left:-4%;top:-6%;width:56%" />
            <img class="f" data-depth="0.7" src={leaf('leaf-palm-right')} alt="" style="right:-5%;top:-4%;width:32%" />
            <img class="f" data-depth="1" src={leaf('leaf-banana-a')} alt="" style="left:-6%;bottom:-20%;width:26%" />
            <img class="f" data-depth="1.3" src={leaf('leaf-fern')} alt="" style="right:6%;bottom:-8%;width:42%" />
          </div>
        </div>
        <div class="stage s2" aria-hidden="true">
          <img class="glass-sharp" src={img('glass-backwater')} alt="" />
          <canvas class="glass" id="glass"></canvas>
        </div>
        <div class="stage s3" aria-hidden="true">
          <img class="leaf-photo" src={img('glass-backwater')} alt="" />
          <div class="layers">
            <img class="L" data-z="0.35" src={leaf('leaf-tree-left')} alt="" style="left:-6%;top:-4%;height:112%" />
            <img class="L" data-z="0.35" src={leaf('leaf-tree-right')} alt="" style="right:-6%;top:-4%;height:112%" />
            <img class="L" data-z="0.7" src={leaf('leaf-vine')} alt="" style="left:10%;top:-8%;width:80%" />
            <img class="L" data-z="1" src={leaf('leaf-banana-b')} alt="" style="left:-22%;bottom:-34%;width:62%" />
            <img class="L" data-z="1.3" src={leaf('leaf-areca')} alt="" style="right:-6%;bottom:-14%;height:78%" />
          </div>
        </div>
        <div class="stage s4" aria-hidden="true">
          {site.scenes.map((sc, k) => (
            <div class={`scn ${k === 0 ? 'on' : ''}`} data-i={k}>
              <img src={img(sc.img)} alt="" fetchpriority={k === 0 ? 'high' : 'low'} />
              {existsSync(`public/video/scene-${k + 1}.mp4`) && <video muted playsinline preload="none" data-src={`${base}video/scene-${k + 1}.mp4`}></video>}
            </div>
          ))}
          <img class="zoomblur" src={img('hero-mist-zoom')} alt="" />
        </div>
        <div class="cs" id="cs" data-tone="dark" data-audio={`${base}audio/`}>
          <div class="cs-scrim up" id="scrim-top"></div><div class="cs-scrim low" id="scrim-low"></div>
          <div class="cs-vig" id="cs-vig"></div>
          <h2 class="cs-endtitle" id="cs-endtitle" aria-hidden="true"></h2>
          <div class="cs-head">
            <h1 class="cs-title" id="h4-title" aria-label="God's Own Country">{site.scenes[0].title.map((t) => <span class="ln">{t}</span>)}</h1>
            <div class="cs-ml" id="cs-ml" aria-hidden="true"><span>{site.scenes[0].ml![0]}</span><i></i><span>{site.scenes[0].ml![1]}</span></div>
          </div>
          <div class="cs-meta"><span id="cs-time">[ -- ]</span><span>KERALAM, INDIA</span><span>INDIA STANDARD TIME</span></div>
          <nav class="cs-nav" aria-label="Sections">
            <a href="#places">PLACES</a><a href="#months">WHEN TO COME</a><a href="#stays">STAYS</a><a href="#trips">JOURNEYS</a>
          </nav>
          <button class="cs-sound" id="cs-sound" type="button" aria-pressed="false">SOUND OFF</button>
          <a class="cs-cta" href={site.officialUrl}>PLAN YOUR TRIP <span aria-hidden="true">&rarr;</span></a>
          <p class="cs-p" id="cs-p">{site.scenes[0].p}</p>
          <p class="cs-line" id="h4-line"></p>
          <div class="cs-end" id="cs-end" aria-hidden="true">
            <img class="cs-end-logo" src={`${base}img/kerala-logo.svg`} alt="Keralam" />
          </div>
          <span class="cs-c">&copy;2026</span>
          <span class="cs-scroll">SCROLL DOWN</span>
        </div>
        <div class="hero-copy">
          <h1 class="hero-title" id="hero-title">
            <span class="line"><span class="line-in">{site.hero.pre}</span></span>
            <span class="line"><span class="line-in"><i>{site.hero.accent}</i></span></span>
          </h1>
          <p class="hero-sub">{site.hero.sub}</p>
        </div>
        <p class="scroll-cue">Scroll to discover</p>
      </section>

      <!-- 2 STATEMENT -->
      <section class="statement" id="statement" data-tone="light">
        <div class="st-text">
          <p class="st-copy" data-split>{site.statement.text}</p>
          <a class="btn" href={site.statement.href}>{site.statement.cta}</a>
        </div>
        <div class="st-photos">
          <img class="st-a" src={img('statement-a')} alt={alt('statement-a')} loading="lazy" />
          <img class="st-b" src={img('statement-b')} alt={alt('statement-b')} loading="lazy" />
        </div>
      </section>

      <!-- 3 PINNED DESTINATION FAN -->
      <section class="fan" id="places" data-tone="dark">
        <div class="fan-pin">
          <h2 class="sr">Destinations</h2>
          <div class="fan-bg" aria-hidden="true">
            {site.places.map((p, i) => <img class={i === 0 ? 'on' : ''} src={img(p.img)} alt="" loading="lazy" />)}
          </div>
          <div class="fan-cards">
            {site.places.map((p, i) => (
              <article class="place" data-i={i}>
                <img src={img(p.img)} alt={alt(p.img)} loading="lazy" />
                <div class="place-text">
                  <h3>{p.name}</h3>
                  <p>{p.line} {p.months}.</p>
                </div>
              </article>
            ))}
          </div>
          <div class="fan-names" aria-hidden="true">
            {site.places.map((p, i) => <span class={i === 0 ? 'on' : ''}>{p.name}</span>)}
          </div>
          <p class="fan-sub" id="fan-sub" aria-hidden="true">{site.places[0].line} {site.places[0].months}.</p>
          <nav class="fan-tabs" aria-label="Destinations">
            {site.places.map((p, i) => <button type="button" data-i={i} class={i === 0 ? 'on' : ''}><b>{String(i + 1).padStart(2, '0')}</b> {p.name}</button>)}
          </nav>
        </div>
      </section>

      <!-- 4 KERALA BY MONTH -->
      <section class="months" id="months" data-tone="dark">
        <div class="m-pin">
          <h2 class="sr">Keralam by month</h2>
          {site.seasons.map((s, si) => (
            <article class={`m-season ${si === 0 ? 'on' : ''}`} data-weather={s.weather} data-si={si}>
              <img class="m-photo" src={img(s.img)} alt={alt(s.img)} loading="lazy" />
              <div class="m-copy">
                {s.months.map((m, mi) => (
                  <div class={`m-month ${si === 0 && mi === 0 ? 'on' : ''}`} data-m={si * 2 + mi}>
                    <h3>{m}</h3>
                    <p>{site.monthLines[m]}</p>
                  </div>
                ))}
              </div>
            </article>
          ))}
          <canvas class="m-weather" id="m-weather" aria-hidden="true"></canvas>
        </div>
      </section>

      <!-- 5 DARK: THE HEART -->
      <section class="heart" id="heart" data-tone="light">
        <div class="heart-pin">
          <div class="drift" aria-hidden="true">
            {[0, 1, 2].map((l) => (
              <div class={`dl dl${l}`}>
                {site.heart.drift.filter((d) => d.l === l).map((d) => <img src={img(d.img)} alt="" loading="lazy" style={`left:${d.x}vw;top:${d.y}%;width:${d.w}vw`} />)}
              </div>
            ))}
          </div>
          <h2 class="heart-title" id="heart-title">{site.heart.pre} <i>{site.heart.accent}</i></h2>
          <div class="heart-text">
            <p>{site.heart.text}</p>
            <a class="btn" href={site.officialUrl}>{site.heart.cta}</a>
          </div>
        </div>
      </section>

      <!-- 6 WATER -->
      <section class="water" id="water" data-tone="light">
        <div class="water-pin">
          <div class="water-frame">
            <video data-src={`${base}video/water.mp4`} poster={img('water-poster')} muted playsinline preload="none" aria-label="Athirappilly waterfall in the monsoon"></video>
          </div>
        </div>
      </section>

      <!-- 7 STORIES -->
      <section class="stories" id="stories" data-tone="light">
        <h2 class="stories-title" data-split>{site.stories.pre} <i>{site.stories.accent}</i></h2>
        <p class="stories-text" data-fade>{site.stories.text}</p>
        <div class="stories-row">
          {site.stories.items.map((s, i) => (
            <figure class={`story s${i}`}>
              <div class="story-img"><video data-src={`${base}video/story-${i + 1}.mp4`} poster={img(`story-${i + 1}-poster`)} muted loop playsinline preload="none" aria-label={s.title}></video></div>
              <figcaption><b>{s.title}</b> {s.line}</figcaption>
            </figure>
          ))}
        </div>
      </section>

      <!-- 8 TRIPS -->
      <section class="trips" id="trips" data-tone="light">
        <h2 class="trips-title" data-split>{site.trips.title}</h2>
        <div class="mosaic">
          {site.trips.items.map((t, i) => (
            <a class={`tile t${i}`} href={site.officialUrl}>
              <img src={img(t.img)} alt={alt(t.img)} loading="lazy" />
              <span class="tile-text"><b>{t.name}</b><i>{t.nights}, best from {t.months}</i><u>More info</u></span>
            </a>
          ))}
        </div>
      </section>

      <!-- 9 STAYS AND AWAY FROM THE PATH -->
      <section class="stays" id="stays" data-tone="light">
        <h2 class="stays-title" data-split>{site.stays.title} <i>{site.stays.accent}</i></h2>
        <p class="stays-intro" data-fade>{site.stays.intro}</p>
        <div class="stay-wrap">
          <button type="button" class="stay-arrow prev" id="stay-prev" aria-label="Previous stay">&larr;</button>
          <div class="car" id="car" tabindex="0" aria-label="Stays">
            {site.stays.items.map((s, i) => (
              <article class="slide" data-i={i}>
                <h3>{s.name}</h3>
                <p class="slide-place">{s.place}</p>
                <div class="slide-img"><img src={img(s.img)} alt={alt(s.img)} loading="lazy" draggable="false" /></div>
                <p class="slide-text">{s.text}</p>
                <a class="pill-o" href={site.officialUrl}>More info</a>
              </article>
            ))}
          </div>
          <button type="button" class="stay-arrow next" id="stay-next" aria-label="Next stay">&rarr;</button>
        </div>
        <div class="stay-dots" id="stay-dots" aria-hidden="true">{site.stays.items.map(() => <i></i>)}</div>
        <div class="away">
          <img src={img(site.stays.away.img)} alt={alt(site.stays.away.img)} loading="lazy" />
          <div class="away-copy">
            <h3>{site.stays.away.title}</h3>
            <p>{site.stays.away.text}</p>
          </div>
        </div>
      </section>

      <!-- 10 CTA AND FOOTER -->
      <section class="cta" id="cta" data-tone="light">
        <img class="cta-sea" src={img('footer-sea')} alt={alt('footer-sea')} loading="lazy" />
        <div class="cta-copy">
          <h2 data-split>{site.cta.title} <i>{site.cta.accent}</i></h2>
          <p>{site.cta.text}</p>
          <a class="btn" href={site.officialUrl}>{site.cta.button}</a>
        </div>
      </section>
    </main>

    <footer class="foot" id="foot" data-tone="light">
      <div class="foot-over">
        <form class="news" onsubmit="return false">
          <label for="mail">{site.footer.news}</label>
          <input id="mail" type="email" placeholder="Email address" />
        </form>
        <div class="cols">
          {site.footer.cols.map((c) => <div><h3>{c.h}</h3>{c.l.map((l) => <a href={site.officialUrl}>{l}</a>)}</div>)}
        </div>
      </div>
      <button class="bigword" id="bigword" type="button" aria-label="Keralam">{site.footer.word}</button>
    </footer>

    <nav class="review" aria-label="Hero options (review only)">
      <a href="#hero=1" data-h="1">Hero 1</a><a href="#hero=2" data-h="2">Hero 2</a><a href="#hero=3" data-h="3">Hero 3</a><a href="#hero=4" data-h="4">Hero 4</a>
    </nav>
    <div class="egg-layer" id="egg-layer" aria-hidden="true"></div>
    <script>import '../scripts/main.ts';</script>
  </body>
</html>
