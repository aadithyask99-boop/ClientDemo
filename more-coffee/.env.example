# Copy this file to .env and fill in the values. .env is git-ignored.
# Never paste the key into chat, code or a commit.

# OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Image model on OpenRouter. Change this if the slug differs for your account.
SEEDREAM_MODEL=bytedance-seed/seedream-5-0-flash

# Where generated assets are written (relative to more-coffee/)
ASSET_OUT_DIR=public/img

# Safety valve: stop a generation run after this many images
MAX_IMAGES_PER_RUN=20
