# Names of the variables stored in secrets/env.age (values live only in the encrypted file).
OPENROUTER_API_KEY=

# Optional, not secret. Shared generation tool: .claude/skills/design-craft/scripts/gen-media.mjs
# Spend cap per run in US dollars (also set a $2 credit limit on the key itself in OpenRouter)
BUDGET_USD=2
IMAGE_MODEL=bytedance-seed/seedream-5-0-flash
VIDEO_MODEL=bytedance/seedance-1-5-pro
