---
import { footer, brand } from '../data/site';
import { u } from '../lib';
---
<footer class="foot" id="footer" data-theme="light">
  <div class="foot__top">
    <div class="foot__sign">
      <h2 class="display h2">{footer.title.map((l) => <span>{l}</span>)}</h2>
      <p>{footer.text}</p>
      <form class="foot__form" id="footForm"><label class="sr" for="footEmail">Email</label><input id="footEmail" type="email" placeholder="Your email" required autocomplete="email" /><button class="pill pill--dark pill--sm" type="submit">Subscribe</button></form>
    </div>
    <nav class="foot__cols" aria-label="Footer">
      {footer.cols.map((c) => <div><h3>{c.h}</h3>{c.links.map((l) => <a href="#top">{l}</a>)}</div>)}
    </nav>
  </div>
  <div class="foot__stage" id="footStage">
    <div class="foot__word" aria-hidden="true" id="footWord">{brand.short}</div>
    <div class="fig fig-a" data-fig="a" data-on="11"><img src={u('img/fig-lean.webp')} alt="" loading="lazy" width="610" height="2143" /><i class="fig__sh" aria-hidden="true"></i></div>
    <div class="fig fig-b" data-fig="b" data-on="8"><img src={u('img/fig-sit.webp')} alt="" loading="lazy" width="900" height="1256" /><i class="fig__sh" aria-hidden="true"></i></div>
    <div class="fig fig-c" data-fig="c" data-on="3"><img src={u('img/fig-lie.webp')} alt="" loading="lazy" width="1200" height="693" /><i class="fig__sh" aria-hidden="true"></i></div>
    <img class="foot__valley" src={u('img/valley.webp')} alt="" loading="lazy" width="2200" height="1238" />
  </div>
</footer>
