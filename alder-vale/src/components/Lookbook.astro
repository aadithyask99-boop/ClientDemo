---
import { lookbook } from '../data/site';
import { u } from '../lib';
const ims = lookbook.images;
const cols = [[0, 2], [1, 3, 4], [5, 6]];
const alts = ['By a frosted lodge window', 'Laughing on the slope', 'Walking through deep snow', 'By the stone fireplace', 'Hands round a mug of cocoa', 'On the cafe terrace', 'Two friends on the lodge bench'];
---
<section class="lb" id="lookbook" data-theme="dark-solid">
  <div class="lb__grid" id="lbGrid">
    {cols.map((c, ci) => (
      <div class="lb__col" data-col={ci}>
        {c.map((i) => <figure class="lb__fig"><img src={u(ims[i].replace('img/', 'img/'))} alt={alts[i]} loading="lazy" width="1100" height="1300" /></figure>)}
      </div>
    ))}
  </div>
  <div class="lb__text">
    <h2 class="display h2">{lookbook.title.map((l) => <span>{l}</span>)}</h2>
    <p>{lookbook.text}</p>
    <a class="pill" href="#lookbook">{lookbook.cta}<span class="go"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"/></svg></span></a>
  </div>
</section>
