---
import '@fontsource-variable/newsreader';
import '@fontsource-variable/albert-sans';
import '../styles/global.css';
import credits from '../../credits.json';
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Photo credits | Kerala Tourism concept</title>
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  </head>
  <body class="credits-page">
    <main class="credits">
      <h1>Photo credits</h1>
      <p>All photographs are from Unsplash, used under the Unsplash licence.</p>
      <ul>
        {credits.map((c: any) => <li><a href={c.page}>{c.by}</a> ({c.name})</li>)}
      </ul>
      <p><a href={base}>Back to the homepage</a></p>
    </main>
  </body>
</html>
