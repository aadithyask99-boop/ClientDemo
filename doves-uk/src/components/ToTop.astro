---
// Scroll-up button: appears after the first screen, a thin ring fills as the page scrolls.
---

<button class="totop" type="button" aria-label="Back to top" data-totop tabindex="-1" aria-hidden="true">
  <svg class="ring" viewBox="0 0 52 52" aria-hidden="true" focusable="false">
    <circle class="ring__track" cx="26" cy="26" r="24"></circle>
    <circle class="ring__bar" cx="26" cy="26" r="24" pathLength="100" data-ring></circle>
  </svg>
  <span class="arrow" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false">
      <path d="M12 19V5"></path>
      <path d="M5.5 11.5 12 5l6.5 6.5"></path>
    </svg>
  </span>
</button>

<style>
  .totop {
    --size: 52px;
    position: fixed;
    right: var(--pad);
    bottom: calc(20px + env(safe-area-inset-bottom));
    z-index: 55;
    width: var(--size);
    height: var(--size);
    padding: 0;
    border: 0;
    border-radius: 50%;
    display: grid;
    place-items: center;
    overflow: hidden;
    isolation: isolate;
    color: var(--blue);
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: blur(14px) saturate(160%);
    -webkit-backdrop-filter: blur(14px) saturate(160%);
    box-shadow: 0 14px 30px -14px rgba(8, 40, 90, 0.55);
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transform: translateY(14px);
    transition: opacity 0.35s var(--ease), transform 0.45s var(--ease), visibility 0s linear 0.35s, color 0.3s var(--ease);
  }

  .totop::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--blue);
    transform: translateY(102%);
    transition: transform 0.45s var(--ease);
  }

  .totop.is-on {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }

  .totop:hover {
    color: #fff;
  }

  .totop:hover::before {
    transform: none;
  }

  .totop:active {
    transform: scale(0.96);
  }

  .ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }

  .ring circle {
    fill: none;
    stroke-width: 2;
  }

  .ring__track {
    stroke: rgba(8, 75, 154, 0.14);
  }

  .ring__bar {
    stroke: var(--blue);
    stroke-linecap: round;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
  }

  .totop:hover .ring__bar {
    stroke: #fff;
  }

  .arrow {
    display: block;
    width: 22px;
    height: 22px;
    transition: transform 0.35s var(--ease);
  }

  .arrow svg {
    width: 100%;
    height: 100%;
  }

  .totop:hover .arrow {
    transform: translateY(-3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .totop,
    .totop::before,
    .arrow {
      transition: none;
    }
  }
</style>
