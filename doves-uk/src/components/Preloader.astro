---
// Draft-only preloader: white screen, a quiet 0 to 100% in the middle, then the page sharpens from a
// slight blur as the screen fades. Shown on dev and on the demo deploy (PUBLIC_PRELOADER=1), not in production.
---

<div class="preloader" data-preloader aria-hidden="true">
  <span class="pct"><span data-pct>0</span>%</span>
</div>

<style is:global>
  .preloader {
    display: none;
  }

  html.preloading {
    overflow: hidden;
  }

  html.preloading .preloader,
  html.preloader-out .preloader {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    place-items: center;
    background: #fff;
    transition: opacity 0.9s cubic-bezier(0.22, 0.7, 0.2, 1);
  }

  html.preloader-out .preloader {
    opacity: 0;
    pointer-events: none;
  }

  .preloader .pct {
    font-size: 0.9375rem;
    font-weight: 400;
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
    color: #6b7588;
    transition: opacity 0.35s ease, transform 0.6s cubic-bezier(0.22, 0.7, 0.2, 1);
  }

  html.preloader-out .preloader .pct {
    opacity: 0;
    transform: translateY(-6px);
  }

  /* The page sits slightly blurred behind the white screen, then sharpens as it fades */
  html.preloading body > *:not(.preloader),
  html.preloader-out body > *:not(.preloader) {
    filter: blur(14px);
    transform: scale(1.012);
    transition: filter 1.1s cubic-bezier(0.22, 0.7, 0.2, 1), transform 1.1s cubic-bezier(0.22, 0.7, 0.2, 1);
  }

  html.preloader-out:not(.preloading) body > *:not(.preloader) {
    filter: none;
    transform: none;
  }

  /* Hero entrance animations wait until the screen lifts */
  html.preloading .hero .line > span,
  html.preloading .hero__cta {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    html.preloading body > *:not(.preloader),
    html.preloader-out body > *:not(.preloader) {
      filter: none;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  import '../scripts/preloader';
</script>
