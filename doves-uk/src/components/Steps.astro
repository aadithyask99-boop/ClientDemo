---
import { steps } from '../data/site';

/*
  Automatic 1 to 4 sequence (16 s loop, no scroll or mouse needed). Each step owns a 3 s slot:
  its line fills, its number turns blue and its text comes to full strength.
  Everything holds, fades, and the loop restarts. The keyframes are generated
  here so the timing lives in one place.
*/
const CYCLE = 16;
const SLOT = 3;
const pct = (s: number) => +((s / CYCLE) * 100).toFixed(3);
let css = '';
steps.items.forEach((_, i) => {
  const a = pct(i * SLOT);
  const b = pct((i + 1) * SLOT);
  const settle = pct(i * SLOT + 0.35);
  const lit = pct(i * SLOT + 0.7);
  css += `
@keyframes st-fill${i}{0%,${a}%{transform:scaleX(0);opacity:1}${b}%{transform:scaleX(1);opacity:1}88%{transform:scaleX(1);opacity:1}96%{transform:scaleX(1);opacity:0}100%{transform:scaleX(0);opacity:0}}
@keyframes st-num${i}{0%,${a}%{color:#c3cfe0}${settle}%,88%{color:#084b9a}96%,100%{color:#c3cfe0}}
@keyframes st-txt${i}{0%,${a}%{opacity:.42}${lit}%,88%{opacity:1}96%,100%{opacity:.42}}
.steps.run .s${i} .fill{animation:st-fill${i} ${CYCLE}s linear infinite}
.steps.run .s${i} .n{animation:st-num${i} ${CYCLE}s linear infinite}
.steps.run .s${i} .txt{animation:st-txt${i} ${CYCLE}s linear infinite}
`;
});
css += `
.steps.run.paused *{animation-play-state:paused !important}
.js .steps:not(.run):not(.static) .fill{transform:scaleX(0)}
.js .steps:not(.run):not(.static) .n{color:#c3cfe0}
.js .steps:not(.run):not(.static) .txt{opacity:.42}`;
---

<Fragment set:html={`<style>${css}</style>`} />

<section class="sec steps" id="how-it-works" data-steps>
  <div class="wrap">
    <div class="split reveal">
      <h2 class="t-title">{steps.title}</h2>
      <p class="t-lead muted">{steps.body}</p>
    </div>

    <ol class="list">
      {
        steps.items.map((s, i) => (
          <li class={`step s${i}`}>
            <div class="track" aria-hidden="true"><span class="fill"></span></div>


            <div class="txt">
              <span class="n" aria-hidden="true">{i + 1}</span>
              <h3>{s.title}</h3>
              <p class="muted">{s.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .list {
    margin-top: clamp(32px, 6vw, 88px);
    display: grid;
    gap: 26px 28px;
  }

  .step {
    display: grid;
    grid-template-columns: 1fr;
    align-content: start;
    align-items: start;
  }

  .track {
    grid-column: 1 / -1;
    height: 3px;
    margin-bottom: 16px;
    border-radius: 3px;
    background: var(--line);
    overflow: hidden;
  }

  .fill {
    display: block;
    height: 100%;
    background: var(--blue);
    transform-origin: left center;
    border-radius: 3px;
  }

  .txt {
    display: grid;
    gap: 4px;
  }

  .n {
    font-size: var(--fs-title);
    line-height: 1;
    letter-spacing: -0.06em;
    color: var(--blue);
    font-weight: 400;
  }

  .txt h3 {
    margin-top: 6px;
    font-size: var(--fs-h3);
    letter-spacing: -0.035em;
  }

  .txt p {
    max-width: 20rem;
    font-size: var(--fs-body);
  }

  @media (min-width: 640px) {
    .list {
      grid-template-columns: 1fr 1fr;
      row-gap: 48px;
    }
  }

  /* Wide screens: four columns */
  @media (min-width: 1100px) {
    .list {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fill,
    .n,
    .txt {
      animation: none !important;
    }
  }
</style>
