---
import type { ImageMetadata } from 'astro';
import Photo from './Photo.astro';
import { covers, repatriation } from '../data/site';

const imgs = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/covers/*.jpg', { eager: true });
const photo = (name: string) => imgs[`../assets/photos/covers/${name}.jpg`].default;

const captions: Record<string, string> = {
  'Attendance fees': repatriation.captions.attendance,
  'Airport clearance': repatriation.captions.airport,
};
---

<section class="covers" id="covers" data-carousel>
  <div class="wrap covers__head reveal">
    <div>
      <h2 class="t-title">{covers.title}</h2>
      <p class="muted covers__body">{covers.body}</p>
    </div>
    <div class="arrows">
      <button class="round" type="button" data-prev aria-label="Previous covers">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
      </button>
      <button class="round" type="button" data-next aria-label="Next covers">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
      </button>
    </div>
  </div>

  <ul class="rail" data-rail tabindex="0" aria-label={covers.title}>
    {
      covers.items.map((item) => (
        <li class="card zoom">
          <div class="card__img">
            <Photo
              src={photo(item.image)}
              alt={item.alt}
              sizes="(min-width: 1000px) 720px, 130vw"
              widths={[600, 900, 1300, 1800]}
              position={item.pos}
            />
          </div>
          <div class="card__shade" aria-hidden="true"></div>
          <h3>{item.title}</h3>
          {captions[item.title] && <p>{captions[item.title]}</p>}
        </li>
      ))
    }
  </ul>

  <div class="wrap"><div class="progress" aria-hidden="true"><span data-progress></span></div></div>
  <span class="drag-chip" data-chip aria-hidden="true">Drag</span>
</section>

<style>
  .covers {
    padding-bottom: clamp(72px, 10vw, 150px);
  }

  .covers__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: clamp(28px, 4vw, 48px);
  }

  .covers__body {
    margin-top: 12px;
    max-width: 34rem;
  }

  .arrows {
    display: flex;
    gap: 10px;
    flex: none;
  }

  .round {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1.5px solid var(--line);
    background: #fff;
    color: var(--ink);
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: background-color 0.25s, color 0.25s, border-color 0.25s, opacity 0.25s;
  }

  .round svg {
    width: 20px;
    height: 20px;
  }

  .round:hover:not(:disabled) {
    background: var(--blue);
    border-color: var(--blue);
    color: #fff;
  }

  .round:disabled {
    opacity: 0.35;
    cursor: default;
  }

  /* Contained carousel: first card lines up with the page, the row bleeds off the right edge */
  .rail {
    --cw: clamp(250px, 23vw, 330px);
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-inline: calc(var(--edge) + var(--pad));
    scroll-padding-inline: calc(var(--edge) + var(--pad));
    scrollbar-width: none;
    outline-offset: -4px;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
    overscroll-behavior-x: contain;
  }

  .rail::-webkit-scrollbar {
    display: none;
  }

  .rail.is-dragging {
    cursor: grabbing;
    scroll-behavior: auto;
  }

  @media (hover: hover) and (pointer: fine) {
    .rail {
      cursor: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rail {
      cursor: grab;
    }
  }

  .progress {
    margin-top: 22px;
    height: 2px;
    border-radius: 2px;
    background: var(--line);
    overflow: hidden;
  }

  .progress span {
    display: block;
    height: 100%;
    width: 100%;
    background: var(--blue);
    transform-origin: left center;
    transform: scaleX(0.12);
    transition: transform 0.25s var(--ease);
  }

  .card {
    position: relative;
    flex: none;
    width: var(--cw);
    aspect-ratio: 3 / 4.2;
    border-radius: var(--r);
    overflow: hidden;
    scroll-snap-align: start;
    color: #fff;
    background: var(--ink);
  }

  .card__img,
  .card__shade {
    position: absolute;
    inset: 0;
  }

  .card__img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card__shade {
    background:
      linear-gradient(to bottom, rgba(6, 16, 36, 0.68), transparent 38%),
      linear-gradient(to top, rgba(6, 16, 36, 0.6), transparent 36%);
  }

  .card h3 {
    position: absolute;
    top: 18px;
    left: 18px;
    right: 18px;
    font-size: var(--fs-h3);
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: #fff;
  }

  .card p {
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 18px;
    font-size: 1rem;
    letter-spacing: -0.01em;
    color: rgba(255, 255, 255, 0.92);
  }

  @media (max-width: 599px) {
    .arrows {
      display: none;
    }
  }
</style>
