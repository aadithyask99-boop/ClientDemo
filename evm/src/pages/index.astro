---
import Base from '../layouts/Base.astro';
import Intro from '../components/Intro.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Statement from '../components/Statement.astro';
import Photo from '../components/Photo.astro';
import Marques from '../components/Marques.astro';
import Sectors from '../components/Sectors.astro';
import Milestones from '../components/Milestones.astro';
import Proof from '../components/Proof.astro';
import Careers from '../components/Careers.astro';
import Footer from '../components/Footer.astro';
---
<Base>
  <Intro />
  <Header />
  <main>
    <Hero />
    <Statement />
    <Photo />
    <Marques />
    <Sectors />
    <Photo which="two" />
    <Milestones />
    <Proof />
    <Careers />
  </main>
  <Footer />
  <script>
    import '../scripts/main';
  </script>
</Base>
