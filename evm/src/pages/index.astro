---
import Base from '../layouts/Base.astro';
import Intro from '../components/Intro.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Statement from '../components/Statement.astro';
import Photo from '../components/Photo.astro';
import Marques from '../components/Marques.astro';
import Sectors from '../components/Sectors.astro';
import Beliefs from '../components/Beliefs.astro';
import Chronicle from '../components/Chronicle.astro';
import Letters from '../components/Letters.astro';
import People from '../components/People.astro';
import Recognition from '../components/Recognition.astro';
import Reader from '../components/Reader.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---
<Base>
  <Intro />
  <Header />
  <main>
    <Hero />
    <Statement />
    <Photo />
    <Marques />
    <Sectors />
    <Beliefs />
    <Chronicle />
    <Letters />
    <People />
    <Recognition />
    <Reader />
    <Contact />
  </main>
  <Footer />
  <script>
    import '../scripts/main';
  </script>
</Base>
