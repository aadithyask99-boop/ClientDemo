---
import { site } from '../data/site';
---
<section class="quotes" data-theme="dark">
  <ul class="quotes__list">
    {site.quotes.map((q) => (
      <li class="quote">
        <blockquote>{q.text}</blockquote>
        <p><strong>{q.who}</strong><span>{q.car}</span></p>
      </li>
    ))}
  </ul>
</section>
