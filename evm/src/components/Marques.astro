---
import { site } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const m = site.marques;
---
<section class="marques" id="marques" data-theme="light">
  <p class="label marques__label">{m.label}</p>
  <p class="label marques__caption">{m.caption}</p>
  <ol class="marques__list">
    {m.items.map((it, i) => <li class={i === 0 ? 'is-active' : ''}><a href={`${base}/marques/${it.slug}`}>{it.name}</a></li>)}
  </ol>
  <div class="marques__tile">
    {m.items.map((it, i) => <img class={i === 0 ? 'is-active' : ''} src={`${base}/img/${it.img}`} alt={it.alt} style={`object-position:${it.pos}`} loading="lazy" />)}
  </div>
</section>
