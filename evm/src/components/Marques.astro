---
import { site } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const m = site.marques;
---
<section class="roller marques" id="marques" data-theme="dark" style={`--n:${m.items.length}`}>
  <div class="roller__pin">
    <h2 class="roller__title">{m.title}</h2>
    <ol class="roller__list">
      {m.items.map((it, i) => (
        <li class={i === 0 ? 'is-active' : ''} data-i={i}>
          <a href={`${base}/marques/${it.slug}`}><span>{it.name}</span><i aria-hidden="true">&rarr;</i></a>
        </li>
      ))}
    </ol>
    <div class="roller__stage">
      <div class="roller__frame">
        {m.items.map((it, i) => (
          <img class={i === 0 ? 'is-active' : ''} src={`${base}/img/${it.img}`} alt={it.alt} style={`object-position:${it.pos}`} loading="lazy" />
        ))}
      </div>
      <p class="roller__note">
        {m.items.map((it, i) => <span class={i === 0 ? 'is-active' : ''}>{it.note}</span>)}
      </p>
    </div>
  </div>
</section>
