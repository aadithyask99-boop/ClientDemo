---
import { site } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { which = 'photo' } = Astro.props;
const ph = which === 'two' ? site.photoTwo : site.photo;
---
<section class="photo" data-theme="dark">
  <img src={`${base}/img/${ph.img}`} alt={ph.alt} loading="lazy" />
</section>
