---
import { site } from '../data/site';
import Mark from './Mark.astro';
---
<footer class="footer" id="contact" data-theme="light">
  <div class="footer__top">
    <p class="label">{site.tagOne}</p>
    <p class="label">{site.footer.address}</p>
    <nav class="footer__links" aria-label="Footer">
      {site.nav.slice(0, 4).map((n) => <a href={n.href}>{n.label}</a>)}
    </nav>
  </div>
  <Mark class="footer__mark" />
  <div class="footer__contact">
    <p class="label label--mute">Contact</p>
    <p class="label">{site.footer.contactNote}</p>
  </div>
  <p class="label footer__legal">{site.footer.legal}</p>
</footer>
