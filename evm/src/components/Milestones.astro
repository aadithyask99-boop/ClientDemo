---
import { site } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const m = site.milestones;
---
<section class="milestones" id="history" data-theme="light" aria-label="Milestones">
  <p class="label">{m.label}</p>
  <ol class="milestones__list">
    {m.items.map((it) => <li><span class="milestones__y">{it.y}</span><span class="milestones__t">{it.t}</span></li>)}
  </ol>
  <p class="more milestones__more"><a href={`${base}${m.link.href}`}>{m.link.label}</a></p>
</section>
