---
import { site } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const m = site.milestones;
const n = m.items.length;
const digits = [0, 1, 2, 3];
---
<section class="milestones" id="history" data-theme="light" aria-label="Milestones" style={`--n:${n}`}>
  <div class="ms__pin">
    <p class="label ms__label">{m.label}</p>
    <ol class="ms__static">
      {m.items.map((it) => <li><span class="ms__sy">{it.y}</span><span class="ms__st">{it.t}</span></li>)}
    </ol>
    <div class="ms__line" aria-hidden="true"><i class="ms__fill"></i>{m.items.map((_, i) => <b class="ms__tick" style={`top:${(i + 0.5) / n * 100}%`}></b>)}<u class="ms__node"></u></div>
    <div class="ms__year" aria-hidden="true">
      {digits.map((d) => (
        <span class="ms__digit"><span class="ms__stack">{m.items.map((it) => <span>{it.y[d]}</span>)}</span></span>
      ))}
    </div>
    <div class="ms__side">
      <div class="ms__tile">
        {m.items.map((it, i) => it.img
          ? <img class={i === 0 ? 'is-active' : ''} src={`${base}/img/${it.img}`} alt={it.alt} loading="lazy" />
          : <span class={`ms__logos ${i === 0 ? 'is-active' : ''}`}>{it.logos!.map((l) => <img class="logo" src={`${base}/logos/${l}.svg`} alt="" width="120" height="120" />)}</span>)}
      </div>
      <p class="ms__caption" aria-live="polite">
        {m.items.map((it, i) => <span class={i === 0 ? 'is-active' : ''}>{it.t}</span>)}
      </p>
      <p class="more"><a href={`${base}${m.link.href}`}>{m.link.label}</a></p>
    </div>
  </div>
</section>
