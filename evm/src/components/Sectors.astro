---
import { site } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const s = site.sectors;
---
<section class="roller sectors" id="sectors" data-theme="dark" style={`--n:${s.items.length}`}>
  <div class="roller__pin">
    <h2 class="roller__title">{s.title}</h2>
    <ol class="roller__list">
      {s.items.map((it, i) => (
        <li class={i === 0 ? 'is-active' : ''} data-i={i}>
          <a href={`${base}/sectors/${it.slug}`}><span>{it.name}</span><i aria-hidden="true">&rarr;</i></a>
        </li>
      ))}
    </ol>
    <div class="roller__stage">
      <div class="roller__frame">
        {s.items.map((it, i) => (
          <img class={i === 0 ? 'is-active' : ''} src={`${base}/img/${it.img}`} alt={it.alt} loading="lazy" />
        ))}
      </div>
      <p class="roller__note">
        {s.items.map((it, i) => <span class={i === 0 ? 'is-active' : ''}>{it.text}</span>)}
      </p>
    </div>
  </div>
</section>
