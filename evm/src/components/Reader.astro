---
import { site } from '../data/site';
const r = site.reader;
---
<section class="reader" aria-label="What people say" id="reviews" data-theme="dark" style={`--n:${r.items.length}`}>
  <div class="reader__pin">
    <p class="label reader__label">{r.label}</p>
    <ol class="reader__names">
      {r.items.map((it, i) => <li class={i === 0 ? 'is-active' : ''} tabindex="0"><span>{it.who}</span><em>{it.car}</em></li>)}
    </ol>
    <div class="reader__quotes">
      {r.items.map((it, i) => <blockquote class={i === 0 ? 'is-active' : ''}><p class="big">{it.text}</p><cite class="label">{it.who}, {it.car}</cite></blockquote>)}
    </div>
  </div>
</section>
