---
import { site } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section class="history" id="sectors" data-theme="dark">
  <p class="label">{site.history.label}</p>
  <p class="big">{site.history.text}</p>
  <div class="history__row">
    <p class="label">{site.sectors.label}</p>
    <ol class="rows">
      {site.sectors.items.map((s, i) => (
        <li><a href={`${base}/sectors/${s.slug}`}><span class="rows__n">{String(i + 1).padStart(2, '0')}</span><span class="rows__name">{s.name}</span></a></li>
      ))}
    </ol>
  </div>
</section>
