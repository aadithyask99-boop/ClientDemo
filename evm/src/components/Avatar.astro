---
// Flat placeholder portraits drawn in code. Not likenesses of the real people.
const { v = 0 } = Astro.props;
const looks = [
  { skin: '#c9926b', hair: '#e9e9e6', shirt: '#f2f2ef', bg: '#d6dfe2', style: 'bald', glasses: false, stache: false },
  { skin: '#b9825e', hair: '#8c8c8a', shirt: '#cbd5da', bg: '#e1d9cf', style: 'short', glasses: false, stache: true },
  { skin: '#c28d66', hair: '#1b1b1c', shirt: '#2a3340', bg: '#d8dde0', style: 'short', glasses: true, stache: false },
  { skin: '#c99872', hair: '#161617', shirt: '#6f2d3c', bg: '#e3d6d6', style: 'long', glasses: false, stache: false },
];
const l = looks[v];
---
<svg class="avatar" viewBox="0 0 100 100" role="img" aria-label="Placeholder portrait">
  <circle cx="50" cy="50" r="50" fill={l.bg} />
  {l.style === 'long' && <path d="M26 56 C22 24 40 14 50 14 C62 14 78 24 74 56 L74 80 L26 80 Z" fill={l.hair} />}
  <path d="M14 100 C14 78 30 70 50 70 C70 70 86 78 86 100 Z" fill={l.shirt} />
  <rect x="43" y="58" width="14" height="16" rx="5" fill={l.skin} />
  <ellipse cx="50" cy="44" rx="17" ry="20" fill={l.skin} />
  {l.style === 'short' && <path d="M32 40 C30 22 42 18 50 18 C60 18 70 24 68 40 C64 32 58 30 50 30 C42 30 36 32 32 40 Z" fill={l.hair} />}
  {l.style === 'bald' && <path d="M32 42 C32 36 34 32 36 30 C34 38 34 42 34 46 Z M68 42 C68 36 66 32 64 30 C66 38 66 42 66 46 Z" fill={l.hair} />}
  {l.style === 'long' && <path d="M32 44 C30 26 42 22 50 22 C60 22 70 26 68 44 C64 34 58 32 50 32 C42 32 36 34 32 44 Z" fill={l.hair} />}
  {l.stache && <path d="M42 53 C46 50 54 50 58 53 C54 55 46 55 42 53 Z" fill={l.hair} />}
  {l.glasses && <g fill="none" stroke="#111" stroke-width="1.6"><rect x="35" y="40" width="12" height="9" rx="3" /><rect x="53" y="40" width="12" height="9" rx="3" /><path d="M47 44 H53" /></g>}
  <circle cx="43" cy="45" r="1.4" fill="#222" /><circle cx="57" cy="45" r="1.4" fill="#222" />
  {!l.stache && <path d="M44 55 Q50 58 56 55" fill="none" stroke="#5a3a2a" stroke-width="1.4" stroke-linecap="round" />}
</svg>
