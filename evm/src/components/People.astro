---
import { site } from '../data/site';
const p = site.people;
---
<section class="roller people" aria-label="Directors and top management" id="people" data-theme="dark">
  <p class="label roller__label">{p.label}</p>
  <ol class="roller__list">
    {p.items.map((it, i) => <li class={i === 0 ? 'is-active' : ''} tabindex="0"><span>{it.name}</span></li>)}
  </ol>
  <div class="roller__side">
    <div class="roller__tile roller__tile--ini">
      {p.items.map((it, i) => <span class={`ini ${i === 0 ? 'is-active' : ''}`} aria-hidden="true">{it.ini}</span>)}
    </div>
    <p class="label roller__note">
      {p.items.map((it, i) => <span class={i === 0 ? 'is-active' : ''}>{it.role}</span>)}
    </p>
    <p class="label label--mute roller__foot">{p.note}</p>
  </div>
</section>
