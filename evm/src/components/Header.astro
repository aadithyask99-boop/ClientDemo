---
import { site } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<header class="header" data-theme="dark">
  <a class="header__logo" href="#top" aria-label="EVM Group, home">
    <img src={`${base}/evm-logo.svg`} alt="EVM" width="86" height="28" />
  </a>
  <div class="header__actions">
    <a class="header__contact" href="#contact">Contact</a>
    <button class="header__menu" type="button" aria-expanded="false" aria-controls="menu" aria-label="Open menu">
      <span></span><span></span>
    </button>
  </div>
</header>
<div class="menu" id="menu" aria-hidden="true">
  <nav class="menu__links" aria-label="Main">
    {site.nav.map((n, i) => <a href={n.href} data-i={i} tabindex="-1"><span>{n.label}</span></a>)}
  </nav>
  <div class="menu__preview" aria-hidden="true">
    {site.nav.map((n, i) => <img src={`${base}/img/${n.img}`} alt="" data-i={i} loading="lazy" />)}
  </div>
</div>
