---
import { site } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const n = site.next;
---
<section class="next" id="next" data-theme="light" aria-label="Where next">
  <p class="label" data-reveal>{n.label}</p>
  <ol class="next__list">
    {n.items.map((it) => (
      <li data-row>
        <a href={`${base}${it.href}`}><span class="next__name">{it.name}</span></a>
        <p class="next__line label">{it.line}</p>
        <img class="next__thumb" src={`${base}/img/${it.img}`} alt="" loading="lazy" />
      </li>
    ))}
  </ol>
  <div class="next__tile" aria-hidden="true">
    {n.items.map((it) => <img src={`${base}/img/${it.img}`} alt="" loading="lazy" />)}
  </div>
</section>
