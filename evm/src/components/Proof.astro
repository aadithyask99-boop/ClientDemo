---
import { site } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const p = site.proof;
---
<section class="proof" id="proof" data-theme="dark" aria-label="What people say">
  <p class="label" data-reveal>{p.label}</p>
  <blockquote>
    <p class="big" data-words>{p.quote}</p>
    <cite class="label" data-reveal>{p.who}</cite>
  </blockquote>
  <p class="more" data-reveal><a href={`${base}${p.reviews.href}`}>{p.reviews.label}</a></p>
  <div class="proof__figures">
    <p class="label" data-reveal>{p.awardsLabel}<br /><span class="more"><a href={`${base}${p.awardsLink.href}`}>{p.awardsLink.label}</a></span></p>
    <ol class="figures">
      {p.figures.map((f) => (
        <li data-row><span class="figures__n">{f.pre}<b data-count={f.n}>{f.n.toLocaleString('en-US')}</b>{f.suf}</span><span class="figures__t">{f.t}</span></li>
      ))}
    </ol>
  </div>
</section>
