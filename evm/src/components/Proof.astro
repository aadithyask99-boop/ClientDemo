---
import { site } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const p = site.proof;
---
<section class="proof" id="proof" data-theme="dark" aria-label="What people say">
  <div class="proof__top">
    <p class="label" data-reveal>{p.label}</p>
    <blockquote>
      <p class="big" data-words>{p.quote}</p>
      <cite class="label" data-reveal>{p.who}</cite>
    </blockquote>
    <p class="more" data-reveal><a href={`${base}${p.reviews.href}`}>{p.reviews.label}</a></p>
  </div>
  <div class="proof__stage">
    <img class="proof__bg" src={`${base}/img/${p.stage.img}`} alt={p.stage.alt} loading="lazy" />
    <ol class="squares">
      {p.figures.map((f, i) => (
        <li class={`square square--${i + 1}`} data-square>
          <span class="square__n">{f.pre}<b data-count={f.n}>{f.n.toLocaleString('en-US')}</b>{f.suf}</span>
          <span class="square__t">{f.t}</span>
        </li>
      ))}
    </ol>
    <p class="proof__foot label">{p.awardsLabel}<span class="more"><a href={`${base}${p.awardsLink.href}`}>{p.awardsLink.label}</a></span></p>
  </div>
</section>
