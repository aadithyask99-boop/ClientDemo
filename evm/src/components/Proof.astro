---
import { site } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const p = site.proof;
---
<section class="proof" id="proof" data-theme="red" aria-label="What people say">
  <div class="proof__top">
    <p class="label" data-reveal>{p.label}</p>
    <blockquote>
      <p class="big" data-words>{p.quote}</p>
      <cite class="label" data-reveal>{p.who}</cite>
    </blockquote>
    <p class="more" data-reveal><a href={`${base}${p.reviews.href}`}>{p.reviews.label}</a></p>
  </div>
  <div class="km">
    <div class="km__pin">
      <ol class="km__track">
        {p.stones.map((st) => (
          <li class="stone"><span class="stone__cap" aria-hidden="true"></span><span class="stone__n">{st.big}</span><span class="stone__t">{st.t}</span></li>
        ))}
      </ol>
      <div class="km__road" aria-hidden="true"></div>
    </div>
  </div>
  <p class="proof__foot label">{p.awardsLabel}<span class="more"><a href={`${base}${p.awardsLink.href}`}>{p.awardsLink.label}</a></span></p>
</section>
