---
import { site } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section class="hero" id="top">
  <div class="hero__pin">
    <div class="hero__film">
      <video class="hero__video" muted playsinline preload="metadata" poster={`${base}/img/hero-poster.webp`} aria-label={site.hero.filmAlt}>
        <source src={`${base}/video/hero.mp4`} type="video/mp4" />
      </video>
    </div>
    <h1 class="hero__title">
      {site.hero.lines.map((l) => <span class="line"><span>{l}</span></span>)}
    </h1>
    <div class="hero__panels">
      {site.panels.map((p) => (
        <a class="panel" href="#statement">
          <img src={`${base}/img/${p.img}`} alt={p.alt} style={`object-position:${p.pos}`} width="900" height="1600" loading="lazy" />
          <span class="panel__dim"></span>
          <span class="panel__cap"><strong>{p.name}</strong><span>{p.place}</span></span>
        </a>
      ))}
    </div>
  </div>
</section>
