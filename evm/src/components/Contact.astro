---
import { site } from '../data/site';
const c = site.contact;
---
<section class="contact" aria-label="Contact and careers" id="contact" data-theme="light">
  <p class="label">{c.label}</p>
  <p class="big contact__intro">{c.intro}</p>
  <div class="contact__grid">
    <div class="contact__offices">
      {c.offices.map((o) => (
        <div class="office"><p class="label label--mute">{o.name}</p><p class="label">{o.lines.map((l) => <span>{l}</span>)}</p></div>
      ))}
    </div>
    <div class="contact__forms">
      <form class="form" data-demo>
        <label><span class="sr">Name</span><input type="text" name="name" placeholder="Your name" autocomplete="name" required /></label>
        <label><span class="sr">Email</span><input type="email" name="email" placeholder="Your email" autocomplete="email" required /></label>
        <label><span class="sr">Phone</span><input type="tel" name="phone" placeholder="Your phone" autocomplete="tel" /></label>
        <label><span class="sr">Subject</span><input type="text" name="subject" placeholder="Subject" /></label>
        <label><span class="sr">Message</span><textarea name="message" rows="3" placeholder="Message" required></textarea></label>
        <button type="submit" class="form__send">Send</button>
        <p class="label label--mute form__status" role="status"></p>
      </form>
      <form class="form form--careers" data-demo>
        <p class="label">{c.careersLabel}</p>
        <p class="label label--mute">{c.careersText}</p>
        <label><span class="sr">Name</span><input type="text" name="cname" placeholder="Your name" autocomplete="name" required /></label>
        <label><span class="sr">Email</span><input type="email" name="cemail" placeholder="Your email" autocomplete="email" required /></label>
        <label class="form__file"><span class="label">Upload resume</span><input type="file" name="resume" accept=".pdf,.doc,.docx" /></label>
        <button type="submit" class="form__send">Apply</button>
        <p class="label label--mute form__status" role="status"></p>
      </form>
      <p class="label label--mute">{c.formNote}</p>
    </div>
  </div>
</section>
